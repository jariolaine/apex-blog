page 12 (
    name: About
    alias: ABOUT
    title: About | &P0_BLOG_APP_NAME.
    pageGroup: @sitemap-main
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    htmlHeader {
        htmlHeader: "\"BLOG_CANONICAL_LINK_TAB\""
    }
    security {
        authentication: public
        formAutoComplete: false
    }
    advanced {
        enableMetaTags: true
    }
    config {
        buildOption: @blog-feature-about
    }

    region about-bloggers (
        name: About Bloggers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                   t1.blogger_name  as region_title
                  ,t1.blogger_desc  as body_html
                from blog_v_bloggers t1
                where 1 = 1
                order by t1.display_seq
                ```
            optimizerHint: APEX$USE_NO_PAGINATION
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverCache {
            caching: true
            cacheTimeout: 1Year
            dependsOnItems: APP_ID
            type: item=value
            item: DEBUG
            value: NO
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @blog-content-custom
            templateOptions: [
                #DEFAULT#
                t-Report--hideNoPagination
            ]
        }
        pagination {
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: &APP_TEXT$BLOG_MSG_NO_DATA_FOUND.
        }
        heading {
            type: none
        }

        column BODY_HTML (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Body Html
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column REGION_TITLE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Region Title
                alignment: center
            }
            layout {
                sequence: 10
            }
            accessibility {
                valueIdentifiesRow: true
            }
            sorting {
                sortable: false
            }
        )

    )

    metaTag description (
        value: About this blog and blog author.
    )

    metaTag og-description (
        name: og:description
        value: About this blog and blog author.
    )

    metaTag og-image (
        name: og:image
        value: &APP_FILES.icons/app-icon-512.png
    )

    metaTag og-title (
        name: og:title
        value: About | &P0_BLOG_APP_NAME.
    )

    metaTag og-type (
        name: og:type
        value: website
    )

    metaTag og-url (
        name: og:url
        value: &P0_PAGE_URL.
    )

)

