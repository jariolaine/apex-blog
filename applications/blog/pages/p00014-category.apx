page 14 (
    name: Categories
    alias: CATEGORY
    title: Category &P14_CATEGORY_TITLE. | &P0_BLOG_APP_NAME.
    pageGroup: @post-report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    htmlHeader {
        htmlHeader: "\"BLOG_CANONICAL_LINK_CATEGORY\""
    }
    security {
        authentication: public
        formAutoComplete: false
    }
    advanced {
        enableMetaTags: true
    }
    config {
        buildOption: @blog-feature-category
    }
    comments {
        comments: Page to show list of post from selected category.
    }

    region category-p14-category-title (
        name: Category &P14_CATEGORY_TITLE.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                   v1.post_title    as search_title
                  ,v1.post_url      as search_link
                  ,v1.post_desc     as search_desc
                 -- see label columns HTML expression
                  ,'Y'              as label_01
                  ,v1.blogger_name  as value_01
                  ,'Y'              as label_02
                  ,v1.published_on  as value_02
                  ,'Y'              as label_03
                  ,v1.tags_html1    as value_03
                  ,null             as label_04
                  ,null             as value_04
                from blog_v_posts v1
                where 1 = 1
                  and v1.category_id = :P14_CATEGORY_ID
                order by v1.published_on desc
                ```
            pageItemsToSubmit: P14_CATEGORY_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: blog-shadow-md
        }
        advanced {
            htmlDomId: page-content-container
        }
        comments {
            comments: Report to show posts in category
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/search-results
            templateOptions: [
                #DEFAULT#
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: &APP_TEXT$BLOG_MSG_NO_DATA_FOUND.
        }
        componentAdvanced {
            stripHtml: true
        }
        heading {
            type: none
        }
        download {
            csvExportEnabled: true
        }

        column LABEL_01 (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Label 01
            }
            layout {
                sequence: 4
            }
            columnFormatting {
                htmlExpression: &APP_TEXT$BLOG_TXT_POSTED_BY.
            }
            sorting {
                sortable: false
            }
        )

        column LABEL_02 (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Label 02
            }
            layout {
                sequence: 6
            }
            columnFormatting {
                htmlExpression: &APP_TEXT$BLOG_TXT_POSTED_ON.
            }
            sorting {
                sortable: false
            }
        )

        column LABEL_03 (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Label 03
                alignment: center
            }
            layout {
                sequence: 8
            }
            columnFormatting {
                htmlExpression: &APP_TEXT$BLOG_TXT_TAGS.
            }
            sorting {
                sortable: false
            }
        )

        column LABEL_04 (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Label 04
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column SEARCH_DESC (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Search Desc
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column SEARCH_LINK (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Search Link
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column SEARCH_TITLE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Search Title
            }
            layout {
                sequence: 1
            }
            accessibility {
                valueIdentifiesRow: true
            }
            sorting {
                sortable: false
            }
        )

        column VALUE_01 (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Value 01
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column VALUE_02 (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Value 02
            }
            layout {
                sequence: 7
            }
            sorting {
                sortable: false
            }
        )

        column VALUE_03 (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Value 03
                alignment: center
            }
            layout {
                sequence: 9
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column VALUE_04 (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Value 04
                alignment: center
            }
            layout {
                sequence: 11
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P14_CATEGORY_ID (
        type: hidden
        layout {
            sequence: 10
            region: @category-p14-category-title
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
            restrictedChars: alphanumWithSpace
        }
        comments {
            comments: Category ID to filter report
        }
    )

    pageItem P14_CATEGORY_TITLE (
        type: hidden
        layout {
            sequence: 70
            region: @/not-rendered-items
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
        }
    )

    dynamicAction set-is-current (
        name: Set is Current
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_CATEGORY_ID
        }
        comments {
            comments: Because categories list in global page is cached, we set is-current class here
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    blog.ui.setListCurrentItem({
                      affectedElements: this.affectedElements
                    , pageItem: "P14_CATEGORY_ID"
                    });
                    ```
            }
            affectedElements {
                selectionType: region
                region: @/categories
            }
            execution {
                sequence: 10
            }
            comments {
                comments: List anchors have data attribute where is category id. If that match to item P14_CATEGORY_ID value set is-current class to list
            }
        )

    )

    metaTag description (
        value: Blog posts filed under category: &P14_CATEGORY_TITLE..
    )

    metaTag og-description (
        name: og:description
        value: Blog posts filed under category: &P14_CATEGORY_TITLE..
    )

    metaTag og-image (
        name: og:image
        value: &APP_FILES.icons/app-icon-512.png
    )

    metaTag og-title (
        name: og:title
        value: Category &P14_CATEGORY_TITLE. | &P0_BLOG_APP_NAME.
    )

    metaTag og-type (
        name: og:type
        value: website
    )

    metaTag og-url (
        name: og:url
        value: &P0_PAGE_URL.
    )

    process get-category-title (
        name: Get category title
        type: invokeApi
        invoke {
            package: BLOG_UTIL
            procedureOrFunction: GET_CATEGORY_TITLE
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17117666390199938
        }

        parameter (
            type: functionResult
            value {
                item: P14_CATEGORY_TITLE
            }
            advanced {
                displaySequence: 20
            }
        )

        parameter p_category_id (
            value {
                type: item
                item: P14_CATEGORY_ID
            }
            advanced {
                displaySequence: 10
            }
        )

    )

    process reset-category-pagination (
        name: Reset Category Pagination
        type: resetPagination
        execution {
            sequence: 20
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 26065583579107833
        }
    )

)

