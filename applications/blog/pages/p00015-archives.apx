page 15 (
    name: Archives
    alias: ARCHIVES
    title: Archives &P15_ARCHIVE_ID. | &P0_BLOG_APP_NAME.
    pageGroup: @post-report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    htmlHeader {
        htmlHeader: "\"BLOG_CANONICAL_LINK_ARCHIVE\""
    }
    security {
        authentication: public
        formAutoComplete: false
    }
    advanced {
        enableMetaTags: true
    }
    config {
        buildOption: @blog-feature-archive
    }
    comments {
        comments: Page to show list of post from selected year.
    }

    region archives-p15-archive-id (
        name: Archives &P15_ARCHIVE_ID.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                   v1.category_id     as category_id
                  ,v1.post_title      as search_title
                  ,v1.post_url        as search_link
                  ,v1.post_desc       as search_desc
                 -- see label columns HTML expression
                  ,'Y'                as label_01
                  ,v1.category_title  as value_01
                  ,'Y'                as label_02
                  ,v1.blogger_name    as value_02
                  ,'Y'                as label_03
                  ,v1.published_on    as value_03
                  ,'Y'                as label_04
                  ,v1.tags_html1      as value_04
                from blog_v_posts v1
                where 1 = 1
                  and v1.archive_year = :P15_ARCHIVE_ID
                order by v1.published_on desc
                
                
                ```
            pageItemsToSubmit: P15_ARCHIVE_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: blog-shadow-md
        }
        advanced {
            htmlDomId: page-content-container
        }
        comments {
            comments: Report to show posts by year (archive)
        }
        reportLayout {
            numberOfRowsType: itemValue
            item: P0_BLOG_SEARCH_ROWS
        }
        componentAppearance {
            template: @/search-results
            templateOptions: [
                #DEFAULT#
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: &APP_TEXT$BLOG_MSG_NO_DATA_FOUND.
        }
        componentAdvanced {
            stripHtml: true
        }
        heading {
            type: none
        }
        download {
            csvExportEnabled: true
        }

        column CATEGORY_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Category Id
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column LABEL_01 (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Label 01
            }
            layout {
                sequence: 5
            }
            columnFormatting {
                htmlExpression: &APP_TEXT$BLOG_TXT_CATEGORY.
            }
            sorting {
                sortable: false
            }
        )

        column LABEL_02 (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Label 02
            }
            layout {
                sequence: 7
            }
            columnFormatting {
                htmlExpression: &APP_TEXT$BLOG_TXT_POSTED_BY.
            }
            sorting {
                sortable: false
            }
        )

        column LABEL_03 (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Label 03
            }
            layout {
                sequence: 9
            }
            columnFormatting {
                htmlExpression: &APP_TEXT$BLOG_TXT_POSTED_ON.
            }
            sorting {
                sortable: false
            }
        )

        column LABEL_04 (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Label 04
                alignment: center
            }
            layout {
                sequence: 11
            }
            columnFormatting {
                htmlExpression: &APP_TEXT$BLOG_TXT_TAGS.
            }
            sorting {
                sortable: false
            }
        )

        column SEARCH_DESC (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Search Desc
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column SEARCH_LINK (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Search Link
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column SEARCH_TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Search Title
            }
            layout {
                sequence: 2
            }
            accessibility {
                valueIdentifiesRow: true
            }
            sorting {
                sortable: false
            }
        )

        column VALUE_01 (
            reportColumnQueryId: 6
            derivedColumn: N
            type: link
            heading {
                heading: Value 01
            }
            layout {
                sequence: 6
            }
            link {
                target: {
                    page: CATEGORY
                    items: {
                        P14_CATEGORY_ID: #CATEGORY_ID#
                    }
                }
                linkText: #VALUE_01#
            }
            sorting {
                sortable: false
            }
        )

        column VALUE_02 (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Value 02
            }
            layout {
                sequence: 8
            }
            sorting {
                sortable: false
            }
        )

        column VALUE_03 (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Value 03
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column VALUE_04 (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Value 04
                alignment: center
            }
            layout {
                sequence: 12
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    pageItem P15_ARCHIVE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @archives-p15-archive-id
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
            restrictedChars: alphanumWithSpace
        }
    )

    dynamicAction set-is-current (
        name: Set is Current
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P15_ARCHIVE_ID
        }
        comments {
            comments: Because archives list in global page is cached, we set is-current class here
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    blog.ui.setListCurrentItem({
                       affectedElements: this.affectedElements
                      ,pageItem: "P15_ARCHIVE_ID"
                    });
                    
                    ```
            }
            affectedElements {
                selectionType: region
                region: @/archives
            }
            execution {
                sequence: 10
            }
            comments {
                comments: List anchors have data attribute where is archive id. If that match to item P15_ARCHIVE_ID value set is-current class to list
            }
        )

    )

    metaTag description (
        value: Blog posts from year &P15_ARCHIVE_ID..
    )

    metaTag og-description (
        name: og:description
        value: Blog post archives from year &P15_ARCHIVE_ID..
    )

    metaTag og-image (
        name: og:image
        value: &APP_FILES.icons/app-icon-512.png
    )

    metaTag og-title (
        name: og:title
        value: Archives &P15_ARCHIVE_ID. | &P0_BLOG_APP_NAME.
    )

    metaTag og-type (
        name: og:type
        value: website
    )

    metaTag og-url (
        name: og:url
        value: &P0_PAGE_URL.
    )

    process reset-archives-pagination (
        name: Reset Archives Pagination
        type: resetPagination
        execution {
            sequence: 20
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 26065829198107836
        }
    )

)

