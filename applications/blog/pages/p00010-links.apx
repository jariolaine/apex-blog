page 10 (
    name: Links
    alias: LINKS
    title: Links | &P0_BLOG_APP_NAME.
    pageGroup: @sitemap-main
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    htmlHeader {
        htmlHeader: "\"BLOG_CANONICAL_LINK_TAB\""
    }
    security {
        authentication: public
        formAutoComplete: false
    }
    advanced {
        enableMetaTags: true
    }
    config {
        buildOption: @blog-feature-links
    }

    region links (
        name: Links
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                  null            as icon_class -- see column HTML expression
                , null            as icon_color_class
                , v1.link_title   as list_title
                , v1.link_desc    as list_text
                , v1.group_title  as list_badge
                , null            as list_class
                , v1.link_url     as link
                , v1.link_attr    as link_attr
                , null            as link_class
                from blog_v_links v1
                where 1 = 1
                order by v1.group_display_seq
                  ,v1.display_seq
                ```
            optimizerHint: APEX$USE_NO_PAGINATION
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/search-results-container
            templateOptions: [
                #DEFAULT#
                t-ResultsRegion--boxed
            ]
            cssClasses: blog-shadow-md
        }
        serverCache {
            caching: true
            cacheTimeout: 1Year
            dependsOnItems: APP_ID
            type: item=value
            item: DEBUG
            value: NO
        }
        comments {
            comments: See column HTML expression for icon_class column
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                u-colors
                t-MediaList--stack
                t-MediaList--iconsRounded
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 100
        }
        messages {
            whenNoDataFound: &APP_TEXT$BLOG_MSG_NO_DATA_FOUND.
        }
        heading {
            type: none
        }

        column ICON_CLASS (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Icon Class
                alignment: center
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: fa fa-external-link
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Icon Color Class
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column LINK (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column LINK_ATTR (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Link Attr
                alignment: center
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column LINK_CLASS (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Link Class
                alignment: center
            }
            layout {
                sequence: 90
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: List Badge
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column LIST_CLASS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: List Class
                alignment: center
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column LIST_TEXT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: List Text
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column LIST_TITLE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: List Title
                alignment: center
            }
            layout {
                sequence: 30
            }
            accessibility {
                valueIdentifiesRow: true
            }
            sorting {
                sortable: false
            }
        )

    )

    metaTag description (
        value: Useful links to other sites.
    )

    metaTag og-description (
        name: og:description
        value: Useful links to other sites.
    )

    metaTag og-image (
        name: og:image
        value: &APP_FILES.icons/app-icon-512.png
    )

    metaTag og-title (
        name: og:title
        value: Links | &P0_BLOG_APP_NAME.
    )

    metaTag og-type (
        name: og:type
        value: website
    )

    metaTag og-url (
        name: og:url
        value: &P0_PAGE_URL.
    )

)

