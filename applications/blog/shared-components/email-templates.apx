emailTemplate BLOG_NEW_COMMENT_NOTIFY (
    name: Blog new comment notification
    emailSubject: #APP_NAME!RAW# new comment notification
    htmlFormat {
        header: <strong>Hello #BLOGGER_NAME#,</strong>
        body: New comment received in the post <a href="#POST_LINK#">#POST_TITLE!STRIPHTML#</a>.
        footer:
            ```html
            Best Regards,<br>
            #APP_NAME!RAW#
            ```
    }
    plainTextFormat {
        content:
            ```html
            Hello #BLOGGER_NAME#,
            
            New comment received in the post "#POST_TITLE!RAW#."
            See post from below link.
            #POST_LINK!RAW#
            
            Best Regards,
            #APP_NAME!RAW#
            ```
    }
    advanced {
        versionNumber: 2
    }
)

