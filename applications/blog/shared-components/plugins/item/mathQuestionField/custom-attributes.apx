customAttribute attribute_01 (
    apexlangName: validationErrorMessage
    attribute: 1
    name: Validation Error Message
    scope: app
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    builder {
        common: false
        showInWizard: false
        translatable: true
    }
    default {
        value: Answer to question isn't correct.
    }
)

customAttribute attribute_01 (
    apexlangName: firstNumberMinValue
    attribute: 1
    name: First Number min Value
    type: integer
    validation {
        required: true
        maxLength: 10
    }
    appearance {
        sequence: 20
    }
    builder {
        displayWidth: 10
    }
    default {
        value: 1
    }
)

