searchConfig comments (
    name: Comments
    searchQueryPrefix: comments
    type: text
    source {
        sqlQuery:
            ```sql
            select
              v1.comment_id     as comment_id
            , v1.post_url       as post_url
            , v1.created_on     as created_on
            , v1.comment_by     as comment_by
            , v1.post_title     as post_title
            , v1.comment_body   as comment_body
            , v1.user_icon      as user_icon
            , v1.icon_modifier  as icon_modifier
            , v1.ctx_search     as ctx_search
            from blog_v_comments v1
            ```
        oracleTextIndexColumn: CTX_SEARCH
        type: sqlQuery
    }
    rowSearch {
        textQueryFunction: searchEngine
    }
    columnMapping {
        primaryKey1Column: COMMENT_ID
        titleColumn: POST_TITLE
    }
    iconAndBadge {
        iconSource: iconClass
        iconCssClasses: fa-comment-o fa-lg
    }
    columnFormatting {
        htmlExpression:
            ```html
            <div class="a-ResultsItem &RESULT_CSS_CLASSES!ATTR.">
              {if ?ICON_VALUE/}
                {case ICON_TYPE/}
                  {when INITIALS/}
                    <div class="a-ResultItem-initials u-color-var">&ICON_VALUE!HTML.</div>
                  {when URL/}
                    <div class="a-ResultItem-image"><img src="&ICON_VALUE!ATTR." alt="&COMMENT_BY!ATTR." role="presentation" /></div>
                  {when CLASS/}
                    <div class="a-ResultItem-icon u-color-var"><span class="fa &ICON_VALUE!ATTR." aria-hidden="true"></span></div>
                {endcase/}
              {endif/}
              <div class="a-ResultsItem-content">
                <div class="a-ResultsItem-header">
                  <span class="a-ResultsItem-title u-flex-grow-1"><a href="&POST_URL!ATTR.">&POST_TITLE!HTML.</a></span>
                  <span class="a-ResultsItem-badge">&APP_TEXT$BLOG_TXT_COMMENT!HTML.</span>
                </div>
                <div class="t-Comments-info">&COMMENT_BY!HTML. <span class="t-Comments-date">&CREATED_ON!HTML.</span></div>
                <div class="a-ResultsItem-description">&COMMENT_BODY!RAW.</div>
              </div>
            </div>
            ```
    }
    appearance {
        cssClasses: blog-comment
    }
    config {
        buildOption: @blog-feature-search-posts
    }
)

searchConfig files (
    name: Files
    searchQueryPrefix: file
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select
              v1.file_id   as file_id
            , v1.file_name as file_name
            , v1.file_desc as file_desc
            , v1.file_size as file_size
            , v1.file_url  as file_url
            from blog_v_files v1
            where 1 = 1
              and v1.is_download = 1
              order by v1.file_name
            ```
        searchableColumns: [
            FILE_NAME
            FILE_DESC
        ]
    }
    columnMapping {
        primaryKey1Column: FILE_ID
        titleColumn: FILE_NAME
        descriptionColumn: FILE_DESC
        badgeColumn: FILE_SIZE
    }
    iconAndBadge {
        iconSource: iconClass
        iconCssClasses: fa-download fa-lg
    }
    columnFormatting {
        htmlExpression:
            ```html
            <div class="a-ResultsItem &RESULT_CSS_CLASSES!ATTR.">
              {if ?ICON_VALUE/}
                {case ICON_TYPE/}
                  {when INITIALS/}
                    <div class="a-ResultsItem-initials u-color-var">&ICON_VALUE!HTML.</div>
                  {when URL/}
                    <div class="a-ResultsItem-image"><img src="&ICON_VALUE!ATTR." alt="&FILE_NAME!ATTR." role="presentation" /></div>
                  {when CLASS/}
                    <div class="a-ResultItem-icon u-color-var"><span class="fa &ICON_VALUE!ATTR." aria-hidden="true"></span></div>
                {endcase/}
              {endif/}
              <div class="a-ResultsItem-content">
                <div class="a-ResultsItem-header">
                  <span class="a-ResultsItem-title u-flex-grow-1">
                    <a href="&FILE_URL!RAW.">&FILE_NAME!HTML.</a>
                  </span>
                  <span class="a-ResultsItem-badge">&APP_TEXT$BLOG_TXT_FILE!HTML.</span>
                </div>
                <div class="a-ResultsItem-description">&FILE_DESC!HTML.</div>
                <div class="a-ResultsItem-misc">&FILE_SIZE!HTML.</div>
              </div>
            </div>
            ```
    }
    config {
        buildOption: @blog-feature-files
    }
)

searchConfig links (
    name: Links
    searchQueryPrefix: link
    source {
        tableName: BLOG_V_LINKS
        searchableColumns: [
            LINK_TITLE
            LINK_DESC
            GROUP_TITLE
        ]
    }
    orderBy {
        orderByClause: group_display_seq, display_seq
    }
    columnMapping {
        primaryKey1Column: LINK_ID
        titleColumn: LINK_TITLE
        descriptionColumn: LINK_TITLE
        badgeColumn: GROUP_TITLE
    }
    iconAndBadge {
        iconSource: iconClass
        iconCssClasses: fa-external-link fa-lg
    }
    columnFormatting {
        htmlExpression:
            ```html
            <div class="a-ResultsItem &RESULT_CSS_CLASSES!ATTR.">
              {if ?ICON_VALUE/}
                {case ICON_TYPE/}
                  {when INITIALS/}
                    <div class="a-ResultItem-initials u-color-var">&ICON_VALUE!HTML.</div>
                  {when URL/}
                    <div class="a-ResultItem-image"><img src="&ICON_VALUE!ATTR." alt="&LINK_TITLE!ATTR." role="presentation" /></div>
                  {when CLASS/}
                    <div class="a-ResultItem-icon u-color-var"><span class="fa &ICON_VALUE!ATTR." aria-hidden="true"></span></div>
                {endcase/}
              {endif/}
              <div class="a-ResultsItem-content">
                <div class="a-ResultsItem-header">
                  <span class="a-ResultsItem-title u-flex-grow-1"><a &LINK_ATTR!RAW. href="&LINK_URL!ATTR.">&LINK_TITLE!HTML.</a></span>
                  <span class="a-ResultsItem-badge">&GROUP_TITLE!HTML.</span>
                </div>
                <div class="a-ResultsItem-description">&LINK_DESC!HTML.</div>
              </div>
            </div>
            ```
    }
    config {
        buildOption: @blog-feature-links
    }
)

searchConfig posts (
    name: Posts
    searchQueryPrefix: post
    type: text
    source {
        sqlQuery:
            ```sql
            select
               v1.post_id         as post_id
              ,v1.blogger_name    as blogger_name
              ,v1.post_title      as post_title
              ,v1.category_title  as category_title
              ,v1.category_url    as category_url
              ,v1.published_on    as published_on
              ,v1.post_url        as post_url
              ,v1.post_desc       as post_desc
              ,v1.ctx_search      as ctx_search
              ,v1.tags_html1      as tags_html
             from blog_v_posts v1
            ```
        oracleTextIndexColumn: CTX_SEARCH
        type: sqlQuery
    }
    rowSearch {
        textQueryFunction: searchEngine
    }
    orderBy {
        orderByClause: APEX$ORATEXT_SCORE desc
    }
    columnMapping {
        primaryKey1Column: POST_ID
        titleColumn: POST_TITLE
        subtitleColumn: POST_DESC
        lastModifiedColumn: PUBLISHED_ON
        customColumn1: CATEGORY_TITLE
        customColumn2: TAGS_HTML
    }
    iconAndBadge {
        iconSource: iconClass
        iconCssClasses: fa-file-text-o fa-lg
    }
    columnFormatting {
        htmlExpression:
            ```html
            <div class="a-ResultsItem &RESULT_CSS_CLASSES!ATTR.">
              {if ?ICON_VALUE/}
                {case ICON_TYPE/}
                  {when INITIALS/}
                    <div class="a-ResultsItem-initials u-color-var">&ICON_VALUE!HTML.</div>
                  {when URL/}
                    <div class="a-ResultsItem-image"><img src="&ICON_VALUE!ATTR." alt="&POST_TITLE!ATTR." role="presentation" /></div>
                  {when CLASS/}
                    <div class="a-ResultItem-icon u-color-var"><span class="fa &ICON_VALUE!ATTR." aria-hidden="true"></span></div>
                {endcase/}
              {endif/}
              <div class="a-ResultsItem-content">
                <div class="a-ResultsItem-header">
                  <span class="a-ResultsItem-title u-flex-grow-1"><a href="&POST_URL!ATTR.">&POST_TITLE!HTML.</a></span>
                  <span class="a-ResultsItem-badge">&APP_TEXT$BLOG_TXT_POST!HTML.</span>
                </div>
                <div class="a-ResultsItem-description">&POST_DESC!HTML.</div>
                <div class="a-ResultsItem-attributes">
                  <span class="a-ResultsItem-attribute">&APP_TEXT$BLOG_TXT_CATEGORY!HTML.: <a href="&CATEGORY_URL!ATTR.">&CATEGORY_TITLE!HTML.</a></span>
                </div>
                <div class="a-ResultsItem-attributes">
                  <span class="a-ResultsItem-attribute">&APP_TEXT$BLOG_TXT_POSTED_BY!HTML.: &BLOGGER_NAME!HTML.</span>
                </div>
                <div class="a-ResultsItem-attributes">
                  <span class="a-ResultsItem-attribute">&APP_TEXT$BLOG_TXT_POSTED_ON!HTML.: &PUBLISHED_ON!HTML.</span>
                </div>
                {if TAGS_HTML/}
                <div class="a-ResultsItem-attributes">
                  <span class="a-ResultsItem-attribute">&APP_TEXT$BLOG_TXT_TAGS!HTML.: &TAGS_HTML!RAW.</span>
                </div>
                {endif/}
              </div>
            </div>
            ```
    }
    config {
        buildOption: @blog-feature-search-posts
    }
)

