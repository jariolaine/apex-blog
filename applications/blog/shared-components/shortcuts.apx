shortcut BLOG_META_ROBOTS_NOINDEX (
    source {
        type: functionBody
        plsqlFunctionBody: return blog_html.get_robots_noindex_meta;
    }
    comments {
        comments: Get meta tag robots noindex. Used in page 4, 1001 and 9999 page html header.
    }
)

shortcut BLOG_RSS_LINK (
    source {
        type: functionBody
        plsqlFunctionBody:
            ```plsql
            return blog_html.get_rss_link(
              p_app_id        => :APP_ID
            , p_app_name      => :P0_BLOG_APP_NAME
            , p_message       => :APP_TEXT$BLOG_TXT_RSS
            , p_build_option  => 'BLOG_FEATURE_RSS'
            );
            ```
    }
    comments {
