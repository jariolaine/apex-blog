shortcut BLOG_ATOM_LINK (
    source {
        type: functionBody
        plsqlFunctionBody:
            ```plsql
            return blog_html.get_atom_link(
              p_app_id        => :APP_ID
            , p_app_name      => :P0_BLOG_APP_NAME
            , p_message       => :APP_TEXT$BLOG_TXT_ATOM
            , p_build_option  => 'BLOG_FEATURE_ATOM'
            );
            ```
    }
    comments {
        comments: Generate atom link to page header. Used in page 1 page html header
    }
)

shortcut BLOG_CANONICAL_LINK_ARCHIVE (
    source {
        type: functionBody
        plsqlFunctionBody:
            ```plsql
            return blog_html.set_archive_canonical_link(
              p_archive_id  => :P15_ARCHIVE_ID
            , p_url         => :P0_PAGE_URL
            );
            
            ```
    }
    comments {
        comments: Get canonical link for archive. Used in page 15 page html header.
    }
)

