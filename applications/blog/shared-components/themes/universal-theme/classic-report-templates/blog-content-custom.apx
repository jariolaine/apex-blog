classicReportTemplate blog-content-custom (
    name: Blog Content (Custom 2)
    templateClass: custom2
    type: namedColumn
    reportTemplate {
        top: <div class="blog-Content #COMPONENT_CSS_CLASSES#" #REPORT_ATTRIBUTES# id="#REGION_STATIC_ID#_report" data-region-id="#REGION_STATIC_ID#">
        bottom: </div>
    }
    rowTemplate1 {
        template:
            ```html
            <div class="blog-Content--Row">
              <h3 class="blog-Content--Title">#REGION_TITLE#</h3>
              <div class="blog-Content--Body">
                #BODY_HTML#
              </div>
            </div>
            ```
        conditionType: plsqlExpression
        plsqlExpression: :REGION_TITLE is not null
    }
    rowTemplate2 {
        template:
            ```html
            <div class="padding-bottom-md">
              #BODY_HTML#
              #CHANGED_ON#
            </div>
            ```
    }
    advanced {
        identifier: BLOG_CONTENT
    }
)

