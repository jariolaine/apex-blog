classicReportTemplate blog-posts-custom (
    name: Blog Posts (Custom 1)
    templateClass: custom1
    type: namedColumn
    reportTemplate {
        top: <div class="blog-posts #COMPONENT_CSS_CLASSES#" #REPORT_ATTRIBUTES# id="#REGION_STATIC_ID#_posts" data-region-id="#REGION_STATIC_ID#">
        bottom:
            ```html
            <div class="blog-posts--pagination">
              <table class="t-Report-pagination t-Report-pagination--bottom" role="presentation">
                #PAGINATION#
              </table>  
            </div>
            </div>
            ```
    }
    rowTemplate1 {
        template:
            ```html
            <article class="blog-post">
              <header class="blog-post--header">
                <div class="blog-post--date">
                  <span class="u-VisuallyHidden">&APP_TEXT$BLOG_TXT_POSTED_ON.</span>
                  <time datetime="#PUBDATE#">#PUBLISHED_ON#</time>
                </div>
                <h1 class="blog-post--title">#POST_TITLE#</h1>
                <div class="blog-post--category">
                  <span class="u-VisuallyHidden">&APP_TEXT$BLOG_TXT_CATEGORY.</span>
                  #CATEGORY_TITLE#
                </div>
              </header>
              <div class="blog-post--body">
                #BODY_HTML#
                <p>#READ_MORE_LINK#</p>
              </div>
              <footer class="blog-post--footer"></footer>
            </article>
            ```
        conditionType: plsqlExpression
        plsqlExpression: :READ_MORE_LINK = 'Y'
    }
    rowTemplate2 {
        template:
            ```html
            <article class="blog-post">
              <header class="blog-post--header">
                <div class="blog-post--date">
                  <span class="u-VisuallyHidden">&APP_TEXT$BLOG_TXT_POSTED_ON.</span>
                  <time datetime="#PUBDATE#">#PUBLISHED_ON#</time>
                </div>
                <h1 class="blog-post--title">#POST_TITLE#</h1>
                <div class="blog-post--category">
                  <span class="u-VisuallyHidden">&APP_TEXT$BLOG_TXT_CATEGORY.</span>
                  #CATEGORY_TITLE#
                </div>
              </header>
              <div class="blog-post--body">#BODY_HTML#</div>
              <footer class="blog-post--footer">
                <div class="blog-post--tags">
                  <span class="u-VisuallyHidden">&APP_TEXT$BLOG_TXT_TAGS.</span>
                  #TAGS_HTML#
                </div>
              </footer>
            </article>
            ```
        conditionType: plsqlExpression
        plsqlExpression: :TAGS_HTML is not null
    }
    rowTemplate3 {
        template:
            ```html
            <article class="blog-post">
              <header class="blog-post--header">    
                <div class="blog-post--date">
                  <span class="u-VisuallyHidden">&APP_TEXT$BLOG_TXT_POSTED_ON.</span>
                  <time datetime="#PUBDATE#">#PUBLISHED_ON#</time>
                </div>
                <h1 class="blog-post--title">#POST_TITLE#</h1>
                <div class="blog-post--category">
                  <span class="u-VisuallyHidden">&APP_TEXT$BLOG_TXT_CATEGORY.</span>
                  #CATEGORY_TITLE#
                </div>
              </header>
              <div class="blog-post--body">#BODY_HTML#</div>
              <footer class="blog-post--footer"></footer>
            </article>
            ```
    }
    pagination {
        template:
            ```html
            <span class="t-Report-paginationText">#TEXT#</span>
            
            ```
        nextPage:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">
              <span class="t-Button-label">#PAGINATION_NEXT#</span><span class="a-Icon icon-right-arrow"></span>
            </a>
            ```
        previousPage:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">
              <span class="a-Icon icon-left-arrow"></span><span class="t-Button-label">#PAGINATION_PREVIOUS#</span>
            </a>
            ```
        nextSet:
            ```html
            <a href="#LINK#" title="#PAGINATION_NEXT_SET#" class="t-Button t-Button--noLabel t-Button--icon t-Button--hot t-Button--small t-Button--simple">
              <span aria-hidden="true" class="t-Icon fa fa-chevron-right"></span>
            </a>
            ```
        previousSet:
            ```html
            <a href="#LINK#" title="#PAGINATION_PREVIOUS_SET#" class="t-Button t-Button--noLabel t-Button--icon t-Button--hot t-Button--small t-Button--simple">
              <span aria-hidden="true" class="t-Icon fa fa-chevron-left"></span>
            </a>
            ```
    }
    advanced {
        identifier: BLOG_POST_REPORT
    }

    templateOption hide-pagination (
        name: Hide Pagination
        sequence: 10
        appearance {
            cssClasses: blog-posts--paginationHidden
        }
        advanced {
            identifier: HIDE_PAGINATION
        }
    )

)

