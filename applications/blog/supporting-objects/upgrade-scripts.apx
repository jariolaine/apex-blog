upgradeScript "Create text indexes" (
    execution {
        sequence: 70
    }
    script {
        contentFile: create-text-indexes.sql
    }
    serverSideCondition {
        type: rowsReturned
        sqlQuery:
            ```sql
            select 1
            from blog_v_version
            where 1 = 1
            and application_date < 20231222
            ```
    }
)

upgradeScript "Database objects upgrade" (
