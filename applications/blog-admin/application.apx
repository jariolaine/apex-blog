app BLOG-ADMIN (
    name: Blog Administration
    version: Release 24.2.11.20260126
    group: @apex-blog
    genAI {
        service: @BLOG_OPEN_AI_API
    }
    logo {
        type: text
        text: &P0_BLOG_APP_NAME.
    }
    navigation {
        homeUrl: {
            page: HOME
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--default
            t-TreeNav--styleA
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        autoDismissSuccessMessages: true
    }
    appFormatMasks {
        date: &P501_DISPLAY_DATE_FORMAT.
        dateTime: &P501_DISPLAY_DATE_FORMAT.
        timestamp: &P501_DISPLAY_DATE_FORMAT.
        timestampTimeZone: &P501_DISPLAY_DATE_FORMAT.
    }
    javaScript {
        fileUrls: #APP_FILES#js/admin#MIN#.js
    }
    css {
        fileUrls: #APP_FILES#css/admin#MIN#.css
    }
    authentication {
        scheme: @apex
        publicUser: APEX_PUBLIC_USER
    }
    authorization {
        scheme: @bloggers
        sourceForRoleOrGroupSchemes: authenticationScheme
    }
    security {
        runtimeApiUsage: [
            modifyThisApp
            modifyOtherApps
            modifyWorkspaceRepository
        ]
    }
    sessionStateProtection {
        allowUrlsCreatedAfter: 2020-03-29T21:15:09
        checksumSalt: B22C496AFD040C7B5F1E21FA4AC20C2D68FA779C3AF68FB8A6F3F4BB268E96B2
        acceptPre202UrlChecksums: false
    }
    globalization {
        documentDirection: leftToRight
        autoTimeZone: true
    }
    progressiveWebApp {
        enable: false
    }
    rowSearch {
        tokenize: false
        textQueryFunction: expertSearch
    }
    reportPrinting {
        type: useInstanceSettings
    }
    errorHandling {
        errorHandlingFunctionName: blog_util.apex_error_handler
    }
    runtime {
        accessibleReadOnlyItems: false
    }
    advanced {
        modernizeApp: true
        copyrightBanner: License: https://raw.githubusercontent.com/jariolaine/apex-blog/master/LICENSE.txt
    }
    comments {
        comments:
            ```
            APEX Blog administration application.
            Source code: https://github.com/jariolaine/apex-blog
            ```
    }

    substitution WORKSPACE_COOKIE (
    )

    substitution BLOG_SELECTED_FILES_COLLECTION (
        value {
            staticValue: SELECTED_FILES
        }
    )

    substitution BLOG_REPLACE_FILES_COLLECTION (
        value {
            staticValue: EXISTING_FILES
        }
    )

    substitution BLOG_DEFAULT_TIMEFRAME (
        value {
            staticValue: 86400
        }
    )

)

