lov file-directories (
    name: FILE_DIRECTORIES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select distinct
              trim( both '/' from file_dir ) as return_value
            from blog_files
            order by 1
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: RETURN_VALUE
    }
)

lov file-sync-action (
    name: FILE_SYNC_ACTION
    source {
        location: staticValues
    }

    entry db (
        sequence: 20
        display: From Object Storage to File Repository
        return: DB
    )

    entry meta (
        sequence: 10
        display: Only File Names From Object Storage to File Repository
        return: META
    )

    entry oci (
        sequence: 30
        display: From File Repository to Object Storage
        return: OCI
    )

)

lov is-active (
    name: IS_ACTIVE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select
              to_number( v1.return_value ) as return_value
            , v1.display_value             as display_value
            from blog_v_lov v1
            where 1 = 1
            and v1.lov_name = 'IS_ACTIVE'
            order by v1.display_seq
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

