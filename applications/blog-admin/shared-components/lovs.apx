lov post-tags (
    name: POST_TAGS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select
               v1.tag             as return_value
              ,v1.tag             as display_value
              ,v1.tag_unique      as display_seq
              ,v1.tag_status_text as status
            from blog_v_all_tags v1
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
        defaultSort: DISPLAY_SEQ
        group: STATUS
