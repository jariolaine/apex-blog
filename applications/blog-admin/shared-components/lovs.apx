lov post-tags-hidden (
    name: POST_TAGS_HIDDEN
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select
              v1.tag as return_value
            , v1.tag as display_value
            from blog_v_all_tags v1
            where 1 = 1
            and v1.is_active = 0
            order by v1.tag_unique
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

lov post-tags-visible (
    name: POST_TAGS_VISIBLE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select
              v1.tag as return_value
            , v1.tag as display_value
            from blog_v_all_tags v1
            where 1 = 1
            and v1.is_active = 1
            order by v1.tag_unique
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

lov sentiment (
    name: SENTIMENT
    source {
        location: staticValues
    }

    entry mixed (
        sequence: 1
        display: Mixed
        return: Mixed
    )

    entry negative (
        sequence: 2
        display: Negative
        return: Negative
    )

    entry neutral (
        sequence: 3
        display: Neutral
        return: Neutral
    )

    entry positive (
        sequence: 4
        display: Positive
        return: Positive
    )

)

lov timeframe-4-weeks (
    name: TIMEFRAME (4 WEEKS)
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 
              disp
            , val as seconds
            from table( apex_util.get_timeframe_lov_data )
            order by insert_order
            ```
    }
    columnMapping {
        return: SECONDS
        display: DISP
    }
)

