lov categories (
    name: CATEGORIES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 
              v1.title                  as return_value
              ,v1.title                 as display_value
              ,v1.category_status_text  as status
              ,v1.display_seq           as display_seq
            from blog_v_all_categories v1
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
        defaultSort: DISPLAY_SEQ
        group: STATUS
        groupSortDirection: descNullsLast
    }

    column DISPLAY_SEQ (
        show: false
        heading {
            heading: Sequence
        }
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column DISPLAY_VALUE (
        heading {
            heading: Category
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column RETURN_VALUE (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
        advanced {
            searchable: false
        }
    )

    column STATUS (
        heading {
            heading: Status
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

)

lov comment-flag-code (
    name: COMMENT_FLAG_CODE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select
              lov.display_value
            , lov.return_value
            from blog_v_lov lov
            where lov.lov_name = 'COMMENT_FLAG'
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
        defaultSort: DISPLAY_VALUE
    }
)

