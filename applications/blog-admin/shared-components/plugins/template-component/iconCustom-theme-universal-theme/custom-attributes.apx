customAttribute ICON_CLASSES (
    apexlangName: iconClasses
    attribute: 2
    name: Icon Classes
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        sequence: 20
    }
)

customAttribute ICON_ID (
    apexlangName: iconId
    attribute: 3
    name: Icon ID
    security {
        escapeMode: htmlAttribute
    }
    appearance {
        sequence: 30
    }
)

customAttribute TEXT (
    apexlangName: text
    attribute: 1
    name: Text
    security {
        escapeMode: raw
    }
    appearance {
        sequence: 10
    }
)

customAttribute TEXT_IN_TITLE (
    apexlangName: textInTitleAttribute
    attribute: 4
    name: Text in Title Attribute
    appearance {
        sequence: 40
    }
    default {
        value: Y
    }
)

