shortcut BLOG_BTN_AI_ASSISTANT (
    source {
        type: functionBody
        plsqlFunctionBody:
            ```plsql
            return
              blog_html.get_button(
                p_app_id          => :APP_ID
              , p_title           => 'BLOG_BTN_TITLE_AI_ASSISTANT'
              , p_button_classes  => 'js-open-assistant'
              , p_icon_classes    => 'fa-lg fa-chatbot'
              , p_build_option    => 'BLOG_FEATURE_GENERATIVE_AI'
              )
            ;
            ```
    }
)

