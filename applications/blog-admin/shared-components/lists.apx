list activity-reports (
    name: Activity Reports

    entry application-error-log (
        label: Application Error Log
        icon {
            imageIconCssClasses: fa-exclamation-triangle-o
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 30022
            }
        }
        userDefinedAttributes {
            1: Report of errors logged by this application
        }
    )

    entry dashboard (
        label: Dashboard
        icon {
            imageIconCssClasses: fa-area-chart
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 30020
            }
        }
        userDefinedAttributes {
            1: View application activity metrics
        }
    )

    entry page-performance (
        label: Page Performance
        icon {
            imageIconCssClasses: fa-file-chart
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 30023
            }
        }
        userDefinedAttributes {
            1: Report of activity and performance by application page
        }
    )

    entry page-views (
        label: Page Views
        icon {
            imageIconCssClasses: fa-file-search
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 30024
                action: resetRegions
            }
        }
        userDefinedAttributes {
            1: Report of each page view including date of access and elapsed time
        }
    )

    entry page-views-metric (
        label: Page Views Metric
        icon {
            imageIconCssClasses: fa-file-clock
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 30021
                action: resetRegions
            }
        }
        userDefinedAttributes {
            1: Summary and breakdown by page report of page view counts and elapsed time
        }
    )

)

