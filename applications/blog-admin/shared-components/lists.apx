        layout {
            sequence: 60
            parentEntry: @g-blogger-name
        }
        isCurrent {
            type: never
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 70
            parentEntry: @g-blogger-name
        }
        isCurrent {
            type: never
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
    )

)

