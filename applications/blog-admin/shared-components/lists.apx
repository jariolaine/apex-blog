        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: never
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry help (
        label: Help
        icon {
            imageIconCssClasses: fa-question-circle-o
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: never
        }
        link {
            target: {
                page: 201
                request: &APP_PAGE_ID.
            }
