page 80 (
    name: Modal Pages
    alias: POPUP-PAGES
    title: Popup Pages
    pageGroup: @modal-pages
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
            t-PageBody--noContentPadding
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
            excludeTitleFromTranslation: true
        }
    )

    region modal-popup-pages (
        name: Modal Popup Pages
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                   v1.id                    as id
                  ,v1.created_on            as created_on
                  ,v1.created_on            as created_since
                  ,v1.created_by            as created_by
                  ,v1.changed_on            as changed_on
                  ,v1.changed_on            as changed_since
                  ,v1.changed_by            as changed_by
                  ,v1.display_seq           as display_seq
                  ,v1.is_active             as status
                  ,v1.is_active             as is_active
                  ,v1.show_changed_on       as show_changed_on
                  ,v1.content_desc          as content_desc
                from blog_v_all_dynamic_content v1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                margin-bottom-none
            ]
            cssClasses: blog-IR--iconLinks
        }
        link {
            linkColumn: customTarget
            target: {
                page: 81
                items: {
                    P81_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-hidden="true" class="t-Icon fa fa-pencil"></span>
            linkAttributes: title="&APP_TEXT$BLOG_TXT_EDIT." class="t-Button t-Button--noLabel t-Button--icon t-Button--small"
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 80284742734189608
        }

        column CHANGED_BY (
            type: plainText
            heading {
                heading: Changed by
            }
            layout {
                sequence: 101
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column CHANGED_ON (
            type: plainText
            heading {
                heading: Changed on
                alignment: end
            }
            layout {
                sequence: 81
                columnAlignment: end
            }
            source {
                dataType: DATE
                timezoneAware: Y
            }
            advanced {
                endUserAlias: D
            }
        )

        column CHANGED_SINCE (
            type: plainText
            heading {
                heading: Changed
                alignment: center
            }
            layout {
                sequence: 91
                columnAlignment: center
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
                timezoneAware: Y
            }
            advanced {
                endUserAlias: Q
            }
        )

        column CONTENT_DESC (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 151
            }
            accessibility {
                valueIdentifiesRow: true
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created by
            }
            layout {
                sequence: 71
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column CREATED_ON (
            type: plainText
            heading {
                heading: Created on
                alignment: end
            }
            layout {
                sequence: 41
                columnAlignment: end
            }
            source {
                dataType: DATE
                timezoneAware: Y
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREATED_SINCE (
            type: plainText
            heading {
                heading: Created
                alignment: center
            }
            layout {
                sequence: 51
                columnAlignment: center
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
                timezoneAware: Y
            }
            advanced {
                endUserAlias: P
            }
        )

        column DISPLAY_SEQ (
            type: plainText
            heading {
                heading: Sequence
                alignment: end
            }
            layout {
                sequence: 111
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IS_ACTIVE (
            type: hidden
            heading {
                heading: Status
            }
            layout {
                sequence: 131
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column SHOW_CHANGED_ON (
            type: plainTextBasedOnLov
            heading {
                heading: Show Changed On
                alignment: center
            }
            lov {
                lov: @is-active
            }
            layout {
                sequence: 141
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column STATUS (
            type: plainTextBasedOnLov
            heading {
                heading: Status
                alignment: center
            }
            lov {
                lov: @is-active
            }
            layout {
                sequence: 121
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {with/}
                    TEXT:=#IS_ACTIVE#
                    ICON_CLASSES:={if IS_ACTIVE/}fa-check-circle u-success-text{else/}fa-minus-circle u-danger-text{endif/} w40
                    {apply THEME$ICON_CUSTOM/}
                    ```
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Modal Popup Pages
        }

        savedReport 419457 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CHANGED_SINCE (
                sequence: 4
            )

            displayColumn CONTENT_DESC (
                sequence: 2
            )

            displayColumn DISPLAY_SEQ (
                sequence: 1
            )

            displayColumn SHOW_CHANGED_ON (
                sequence: 3
            )

            displayColumn STATUS (
                sequence: 5
            )

            sort (
                column: DISPLAY_SEQ
                sort {
                    sequence: 1
                }
            )

        )

    )

    button close (
        buttonName: CLOSE
        label: Close
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-close
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    button create-popup-page (
        buttonName: CREATE_POPUP_PAGE
        label: New
        layout {
            sequence: 10
            region: @modal-popup-pages
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 81
                items: {
                    P81_CONTENT_TYPE: FOOTER_LINK
                }
                clearCache: 81
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button resequence-links (
        buttonName: RESEQUENCE_LINKS
        label: Resequence
        layout {
            sequence: 20
            region: @modal-popup-pages
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-sequence
        }
        behavior {
            action: definedByDynamicAction
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$BLOG_CONFIRM_RESEQUENCE_DYNAMIC_CONTENT.
            style: warning
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Reset Report
        layout {
            sequence: 30
            region: @modal-popup-pages
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: [
                    &APP_PAGE_ID.
                    RIR
                ]
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @close
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @modal-popup-pages
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @modal-popup-pages
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction resequence-modal-popup-pages (
        name: Resequence Modal Popup Pages
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @resequence-links
        }

        action refresh-report (
            name: Refresh Report
            action: refresh
            affectedElements {
                selectionType: region
                region: @modal-popup-pages
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action resequence (
            name: Resequence
            action: executeServerSideCode
            settings {
                plsqlCode: blog_admin.resequence_dynamic_content;
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action show-message (
            name: Show message
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    blog.admin.showSuccessMessage({
                      "text": "BLOG_MSG_DYNAMIC_CONTENT_RESEQUENCED"
                    });
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

)

