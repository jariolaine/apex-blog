page 50 (
    name: Links
    alias: LINKS
    title: Links
    pageGroup: @links
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: No help available for this page.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region link-group (
        name: Link Group
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                  v1.is_active    as icon_class       -- see column HTML Expression
                , v1.is_active    as icon_color_class -- see column HTML Expression
                , apex_page.get_url(
                    p_page    => 52
                  , p_items  => 'P52_ID'
                  , p_values => v1.id
                  )               as link
                , null            as link_attr
                , null            as link_class
                , v1.title        as list_title
                , v1.notes        as list_text
                , null            as list_class
                , null            as list_badge       -- see column HTML Expression
                , v1.display_seq  as display_seq
                , v1.is_active    as is_active
                from blog_v_all_link_groups v1
                where 1 = 1
                and v1.id = :P50_LINK_GROUP_ID
                ```
            pageItemsToSubmit: P50_LINK_GROUP_ID
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--stacked
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 1
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                t-MediaList--stack
                t-Report--hideNoPagination
            ]
        }
        performance {
            maxRowsToProcess: 1
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column DISPLAY_SEQ (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Display Seq
                alignment: center
            }
            layout {
                sequence: 190
            }
        )

        column ICON_CLASS (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Icon Class
                alignment: center
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {case ICON_CLASS/}
                    {when 1/}
                    fa fa-check
                    {otherwise/}
                    fa fa-minus
                    {endcase/}
                    ```
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Icon Color Class
                alignment: center
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {case ICON_COLOR_CLASS/}
                    {when 1/}
                    u-success
                    {otherwise/}
                    u-danger
                    {endcase/}
                    ```
            }
        )

        column IS_ACTIVE (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Is Active
                alignment: end
            }
            layout {
                sequence: 200
                columnAlignment: end
            }
        )

        column LINK (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Link
                alignment: center
            }
            layout {
                sequence: 110
            }
        )

        column LINK_ATTR (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Link Attr
                alignment: center
            }
            layout {
                sequence: 120
            }
        )

        column LINK_CLASS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Link Class
                alignment: center
            }
            layout {
                sequence: 130
            }
        )

        column LIST_BADGE (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: List Badge
                alignment: center
            }
            layout {
                sequence: 170
            }
            columnFormatting {
                htmlExpression: &APP_TEXT$BLOG_TXT_SEQUENCE.: #DISPLAY_SEQ#
            }
        )

        column LIST_CLASS (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: List Class
                alignment: center
            }
            layout {
                sequence: 160
            }
        )

        column LIST_TEXT (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: List Text
                alignment: center
            }
            layout {
                sequence: 150
            }
        )

        column LIST_TITLE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: List Title
                alignment: center
            }
            layout {
                sequence: 140
            }
            accessibility {
                valueIdentifiesRow: true
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    #LIST_TITLE# 
                    <span class="u-VisuallyHidden">(&APP_TEXT$BLOG_TXT_STATUS.: {if IS_ACTIVE/}
                    &APP_TEXT$BLOG_TXT_ENABLED.
                    {else/}
                    &APP_TEXT$BLOG_TXT_DISABLED.
                    {endif/})</span>
                    
                    ```
            }
        )

    )

    region links (
        name: Links
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                  v1.id               as id
                , v1.changed_on       as created_on
                , v1.changed_on       as created_since
                , v1.changed_by       as created_by
                , v1.changed_on       as changed_on
                , v1.changed_on       as changed_since
                , v1.changed_by       as changed_by
                , v1.display_seq      as display_seq
                , v1.link_status_code as link_status
                , v1.title            as title
                , v1.link_desc        as link_desc
                , v1.link_url         as link_url
                , v1.notes            as notes
                , v1.link_is_active   as link_is_active
                from blog_v_all_links v1
                where 1 = 1
                and v1.link_group_id = :P50_LINK_GROUP_ID
                ```
            pageItemsToSubmit: P50_LINK_GROUP_ID
        }
        layout {
            sequence: 30
            slot: fullWidthContent
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
            cssClasses: blog-IR--iconLinks
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P50_LINK_GROUP_ID
        }
        link {
            linkColumn: customTarget
            target: {
                page: 51
                items: {
                    P51_ID: #ID#
                }
                action: resetPagination
            }
            linkIcon: <span aria-hidden="true" class="t-Icon fa fa-pencil"></span>
            linkAttributes: title="&APP_TEXT$BLOG_TXT_EDIT." class="t-Button t-Button--noLabel t-Button--icon t-Button--small"
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            filename: blog-links
            supplementalText: &P0_BLOG_APP_NAME!RAW. links.
        }
        advanced {
            savedReportMappingIdentifier: 45219761514225454
        }

