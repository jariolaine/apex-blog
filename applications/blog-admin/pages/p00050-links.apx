            lov {
                lov: @link-status
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {with/}
                    TEXT:=#LINK_STATUS#
                    ICON_CLASSES:={if LINK_IS_ACTIVE/}fa-check-circle u-success-text{else/}fa-minus-circle u-danger-text{endif/} w40
                    {apply THEME$ICON_CUSTOM/}
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BA
            }
            comments {
                comments: Using HTML Expression because need column filter
