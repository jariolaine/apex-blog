    pageItem P50_LINK_GROUP_ID (
        type: hidden
        layout {
            sequence: 10
            region: @links
            slot: regionBody
        }
        security {
            encryptSessionState: false
            restrictedChars: alphanumWithSpace
        }
    )

    button create-group (
        buttonName: CREATE_GROUP
        label: New Group
        layout {
            sequence: 10
            region: @search-link-groups
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 52
                clearCache: 52
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create-link (
        buttonName: CREATE_LINK
        label: New Link
        layout {
            sequence: 10
            region: @links
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 51
                items: {
                    P51_LINK_GROUP_ID: &P50_LINK_GROUP_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button resequence-groups (
        buttonName: RESEQUENCE_GROUPS
        label: Resequence Groups
        layout {
            sequence: 20
            region: @search-link-groups
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-sequence
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$BLOG_CONFIRM_RESEQUENCE_LINK_GROUPS.
            style: warning
        }
    )

    button resequence-links (
        buttonName: RESEQUENCE_LINKS
        label: Resequence Links
        layout {
            sequence: 20
            region: @links
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-sequence
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$BLOG_CONFIRM_RESEQUENCE_LINKS.
            style: warning
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Reset Report
        layout {
            sequence: 30
            region: @links
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: RIR
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction link-groups-resequence (
        name: Link Groups Resequence
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @resequence-groups
        }

        action refresh-link-group-details (
            name: Refresh Link Group Details
            action: refresh
            affectedElements {
                selectionType: region
                region: @link-group
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action refresh-link-group-list (
            name: Refresh Link Group List
            action: refresh
            affectedElements {
                selectionType: region
                region: @select-link-group
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action resequence-link-groups (
            name: Resequence Link Groups
            action: executeServerSideCode
            settings {
                plsqlCode: blog_admin.resequence_link_groups;
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action show-message (
            name: Show message
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    blog.admin.showSuccessMessage({
                      "text": "BLOG_MSG_LINK_GROUPS_RESEQUENCED"
                    });
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction links-resequence (
        name: Links Resequence
        execution {
            sequence: 80
        }
        when {
            event: click
            selectionType: button
            button: @resequence-links
        }

        action refresh-links-report (
            name: Refresh Links Report
            action: refresh
            affectedElements {
                selectionType: region
                region: @links
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action resequence-links (
            name: Resequence Links
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    blog_admin.resequence_links(
                      p_link_group_id => :P50_LINK_GROUP_ID
                    );
                    ```
                itemsToSubmit: P50_LINK_GROUP_ID
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action show-message (
            name: Show message
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    blog.admin.showSuccessMessage({
                      "text": "BLOG_MSG_LINKS_RESEQUENCED"
                    });
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction process-link (
        name: Process Link
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @links
        }

        action refresh-links-report (
            name: Refresh Links Report
            action: refresh
            affectedElements {
                selectionType: region
                region: @links
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

