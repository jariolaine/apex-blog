            displayColumn LINK_DESC (
                sequence: 3
            )

            displayColumn LINK_STATUS (
                sequence: 5
            )

            displayColumn TITLE (
                sequence: 2
            )

            sort (
                column: DISPLAY_SEQ
                sort {
                    sequence: 1
                }
            )

        )

    )

    region search-link-groups (
        name: Search Link Groups
        type: smartFilters
        source {
            filteredRegion: @select-link-group
        }
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                blog-search-region
                padding-sm
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            compactNosThreshold: 10000
        }

        filter P50_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: LIST_TITLE
            }
            security {
                encryptSessionState: false
            }
        )

    )

    region select-link-group (
        name: Select Link Group
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                  v1.id
                , apex_page.get_url(
                     p_items => 'P50_LINK_GROUP_ID'
                    ,p_values => v1.id
                  )               as link
                , null            as link_class -- See column HTML expression
                , null            as link_attr
                , null            as icon_class
                , null            as icon_color_class
                , case when v1.id = coalesce( to_number( :P50_LINK_GROUP_ID ), 0 )
                    then 'is-active' 
                  end             as list_class
                , substr( v1.title, 1, 50 ) || ( case when length( v1.title ) > 50 then '...' end ) as list_title
                , null            as list_text
                , v1.display_seq  as list_badge
                from blog_v_all_link_groups v1
                where 1 = 1
                order by v1.display_seq
                ```
        }
        layout {
            sequence: 30
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: blog-search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                t-MediaList--stack
                t-MediaList--iconsRounded
                t-Report--hideNoPagination
            ]
            cssClasses: blog-search-results-items
        }
        performance {
            maxRowsToProcess: 500
        }

        column ICON_CLASS (
            reportColumnQueryId: 5
            derivedColumn: N
