    button delete-selected (
        buttonName: DELETE_SELECTED
        label: Delete Selected
        layout {
            sequence: 20
            region: @file-repository
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
            icon: fa-trash-o
        }
        behavior {
            showProcessing: true
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
    )

    button deselect-all (
        buttonName: DESELECT_ALL
        label: Deselect All
        layout {
            sequence: 40
            region: @file-repository
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-square-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @under-development
        }
    )

    button download-selected (
        buttonName: DOWNLOAD_SELECTED
        label: Download Selected
        layout {
            sequence: 50
            region: @file-repository
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-download
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Reset Report
        layout {
            sequence: 70
            region: @file-repository
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: [
                    &APP_PAGE_ID.
                    RIR
                ]
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button select-all (
        buttonName: SELECT_ALL
        label: Select All
        layout {
            sequence: 30
            region: @file-repository
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-check-square-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @under-development
        }
    )

    button upload-file (
        buttonName: UPLOAD_FILE
        label: Upload
        layout {
            sequence: 60
            region: @file-repository
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-upload
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 302
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction after-ir-refresh (
        name: After IR refresh
        execution {
            sequence: 10
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @file-repository
        }

        action format-and-reinitialize (
            name: Format and reinitialize
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    blog.admin.ir.filesAfterRefresh({
                      "region$": this.affectedElements
                    , "browserEvent": this.browserEvent
                    });
                    ```
            }
            affectedElements {
                selectionType: triggeringElement
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction process-file-update (
        name: Process File Update
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @file-repository
        }

        action refresh-report (
            name: Refresh report
            action: refresh
            affectedElements {
                selectionType: region
                region: @file-repository
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction process-file-upload (
        name: Process File Upload
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @upload-file
        }

        action refresh-report (
            name: Refresh report
            action: refresh
            affectedElements {
                selectionType: region
                region: @file-repository
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation at-least-one-files-selected (
        name: At Least one files selected
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from apex_collections
                where 1 = 1
                  and collection_name = :BLOG_SELECTED_FILES_COLLECTION
                ```
        }
        error {
            errorMessage: Please select at least one file.
            displayLocation: inlineInNotification
        }
    )

    process delete-selected-files (
        name: Delete selected files
        type: invokeApi
        invoke {
            package: BLOG_FILE
            procedureOrFunction: DELETE_SELECTED_FILES
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: File(s) deleted.
        }
        advanced {
            executionMappingIdentifier: 22080614920095101
        }
        serverSideCondition {
            whenButtonPressed: @delete-selected
        }
        config {
            buildOption: !@blog-feature-oci-object-storage
        }

        parameter p_collection_name (
            value {
                type: item
                item: BLOG_SELECTED_FILES_COLLECTION
            }
            advanced {
                displaySequence: 10
            }
        )

    )

    process delete-selected-objects (
        name: Delete selected objects
        type: invokeApi
        invoke {
            package: BLOG_OCI_OS
            procedureOrFunction: DELETE_SELECTED_OBJECTS
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 21474010070959477
        }
        serverSideCondition {
            whenButtonPressed: @delete-selected
        }
        config {
            buildOption: @blog-feature-oci-object-storage
        }

        parameter p_client_request_id (
            parameter {
                hasDefault: true
            }
            value {
                type: apiDefault
            }
            advanced {
                displaySequence: 20
            }
        )

        parameter p_collection_name (
            value {
                type: item
                item: BLOG_SELECTED_FILES_COLLECTION
            }
            advanced {
                displaySequence: 10
            }
        )

    )

    process dowbload-selected-files (
        name: Dowbload selected files
        type: invokeApi
        invoke {
            package: BLOG_FILE
            procedureOrFunction: DOWNLOAD_SELECTED_FILES
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 22081649807091818
        }
        serverSideCondition {
            type: request=Value
            value: DOWNLOAD_SELECTED
        }
        config {
            buildOption: !@blog-feature-oci-object-storage
        }

        parameter p_collection_name (
            value {
                type: item
                item: BLOG_SELECTED_FILES_COLLECTION
            }
            advanced {
                displaySequence: 10
            }
        )

    )

    process download-selected-objects (
        name: Download selected objects
        type: invokeApi
        invoke {
            package: BLOG_OCI_OS
            procedureOrFunction: DOWNLOAD_SELECTED_OBJECTS
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 21477168636959470
        }
        serverSideCondition {
            type: request=Value
            value: DOWNLOAD_SELECTED
        }
        config {
            buildOption: @blog-feature-oci-object-storage
        }

        parameter p_client_request_id (
            parameter {
                hasDefault: true
            }
            value {
                type: apiDefault
            }
            advanced {
                displaySequence: 20
            }
        )

        parameter p_collection_name (
            value {
                type: item
                item: BLOG_SELECTED_FILES_COLLECTION
            }
            advanced {
                displaySequence: 10
            }
        )

    )

    process select-file (
        name: SELECT_FILE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                blog_file.file_select_collection(
                  p_collection_name => :BLOG_SELECTED_FILES_COLLECTION
                , p_seq_id          => :APP_AJAX_X01
                , p_id              => :APP_AJAX_X02
                );
                
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 21475896716959471
        }
    )

    process truncate-file-select-collection (
        name: Truncate file select collection
        type: invokeApi
        invoke {
            package: APEX_COLLECTION
            procedureOrFunction: TRUNCATE_COLLECTION
        }
        execution {
            sequence: 40
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 21476288698959471
        }
        serverSideCondition {
            type: expression
            plsqlExpression: apex_collection.collection_exists( :BLOG_SELECTED_FILES_COLLECTION )
        }

        parameter p_collection_name (
            value {
                type: item
                item: BLOG_SELECTED_FILES_COLLECTION
            }
            advanced {
                displaySequence: 10
            }
        )

    )

    branch (
        name: Go to download selected objects
        execution {
            sequence: 20
            point: processing
        }
        behavior {
            target: {
                page: &APP_PAGE_ID.
                request: &REQUEST.
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @download-selected
        }
        config {
            buildOption: @blog-feature-oci-object-storage
        }
    )

    branch (
        name: Go to download selected files
        execution {
            sequence: 10
            point: processing
        }
        behavior {
            target: {
                page: &APP_PAGE_ID.
                request: &REQUEST.
                successMessage: false
            }
        }
        serverSideCondition {
            whenButtonPressed: @download-selected
        }
        config {
            buildOption: !@blog-feature-oci-object-storage
        }
    )

)

