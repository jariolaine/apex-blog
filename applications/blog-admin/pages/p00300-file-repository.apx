page 300 (
    name: File Repository
    alias: FILE-REPOSITORY
    title: Files
    pageGroup: @files
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }

    region breadcrumb (
        name: Breadcrumb
        title: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region file-repository (
        name: File Repository
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select                        
                  v1.id             as id
                , c1.seq_id         as seq_id
                , v1.row_version    as row_version
                -- for filtering selected rows
                , case when c1.seq_id is not null
                    then 1
                    else 0
                  end               as select_file
                , v1.file_path      as file_path
                , v1.created_by     as created_by
                , v1.created_on     as created_on
                , v1.created_on     as created_since
                , v1.changed_by     as changed_by
                , v1.changed_on     as changed_on
                , v1.changed_on     as changed_since
                , v1.file_dir       as file_dir
                , v1.file_name      as file_name
                , v1.file_desc      as file_desc
                , v1.file_size      as file_size
                , v1.mime_type      as mime_type
                , v1.is_download    as show_in_pub_app
                , v1.is_download    as is_download
                , v1.is_active      as file_status
                , v1.is_active      as is_active
                , v1.file_url       as file_url
                , null              as btn_copy_file_url
                , v1.local_size     as local_size
                , v1.etag           as etag
                , v1.md5            as md5
                , v1.sync_timestamp as sync_timestamp
                from blog_v_all_files v1
                left join apex_collections c1 on v1.id = c1.n001
                  and c1.collection_name = :BLOG_SELECTED_FILES_COLLECTION
                ```
        }
        layout {
            sequence: 20
            slot: fullWidthContent
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
            cssClasses: blog-IR--iconLinks
        }
        link {
            linkColumn: customTarget
            target: {
                page: 301
                items: {
                    P301_ID: #ID#
                }
            }
            linkIcon: <span aria-hidden="true" class="t-Icon fa fa-pencil"></span>
            linkAttributes: title="&APP_TEXT$BLOG_TXT_EDIT." class="t-Button t-Button--noLabel t-Button--icon t-Button--small"
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            supplementalText: &P0_BLOG_APP_NAME!RAW. files.
        }
        advanced {
            savedReportMappingIdentifier: 104255797384495596
        }

        column BTN_COPY_FILE_URL (
            type: themeTemplateComponent/buttonCustom
            heading {
                heading: Copy URL
                alternativeLabel: Copy File URL
                alignment: center
            }
            settings {
                label: &APP_TEXT$BLOG_TXT_COPY_TO_CLIPBOARD.
                customAttributes: data-clipboard-source="#FILE_URL#"
            }
            plugin-appearance {
                iconClass: fa-clipboard
                iconOnly: true
                size: small
            }
            layout {
                sequence: 220
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AU
            }
            enableUsersTo {
                sort: false
                filter: false
            }
        )

        column CHANGED_BY (
            type: plainText
            heading {
                heading: Changed by
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AF
            }
        )

