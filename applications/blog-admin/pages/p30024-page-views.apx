page 30024 (
    name: Page Views
    alias: PAGE-VIEWS
    title: Page Views
    pageGroup: @activity-reporting
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
            t-Dialog--noPadding
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>This page provides an interactive report of the most recent page views.</p>
            <p>Select the reporting timeframe (Default = 1 day) at the top of the page as necessary.<br>
            Click on the column headings to sort and filter data, or click on the <strong>Actions</strong> button to customize column display and many additional advanced features. Click the <strong>Reset</strong> button to reset the interactive report back to the default settings.</p>
            ```
    }

    region button-bar (
        name: Button Bar
        type: staticContent
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noBorder
                t-Form--large
            ]
        }
    )

    region page-views (
        name: Page Views
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                  l.page_id                 as page
                , case l.page_id
                    when 1003
                    then replace( lower( l.request_value ), 'application_process=' ) 
                    else l.page_name
                  end                       as page_name
                , l.apex_session_id         as session_id
                , l.view_timestamp 
                    at time zone sessiontimezone
                                            as timestamp
                , l.view_timestamp 
                    at time zone sessiontimezone
                                            as view_since
                , l.elapsed_time            as elapsed
                , l.page_view_mode          as page_mode
                , l.rows_queried            as num_rows
                , l.error_on_component_name as component_name
                , l.page_view_type          as view_type
                , l.page_view_mode          as view_mode
                , l.request_value           as request
                , l.error_message           as error
                , l.ecid                    as ecid
                from apex_workspace_activity_log l
                where 1 = 1
                  and l.application_id = :G_PUB_APP_ID
                  and l.view_date >= sysdate - ( 1/24/60/60 * :P30024_TIMEFRAME )
                  and l.apex_user is not null
                  and l.page_id is not null
                
                ```
            pageItemsToSubmit: P30024_TIMEFRAME
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 43844456202616317
        }

        column COMPONENT_NAME (
            type: plainText
            heading {
                heading: Component Name
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column ECID (
            type: plainText
            heading {
                heading: ECID
                alignment: center
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column ELAPSED (
            type: plainText
            heading {
                heading: Elapsed
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D0000
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column ERROR (
            type: plainText
            heading {
                heading: Error
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column NUM_ROWS (
            type: plainText
            heading {
                heading: Num Rows
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column PAGE (
            type: plainText
            heading {
                heading: Page
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column PAGE_MODE (
            type: plainText
            heading {
                heading: Mode
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column PAGE_NAME (
            type: plainText
            heading {
                heading: Page Name
            }
            layout {
                sequence: 20
            }
            accessibility {
                valueIdentifiesRow: true
            }
            columnFormatting {
                htmlExpression: #PAGE#. #PAGE_NAME#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column REQUEST (
            type: plainText
            heading {
                heading: Request
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column SESSION_ID (
            type: link
            heading {
                heading: Session ID
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            link {
                target: {
                    page: 30026
                    items: {
                        P30026_APEX_SESSION_ID: #SESSION_ID#
                    }
                }
                linkText: #SESSION_ID#
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column TIMESTAMP (
            type: plainText
            heading {
                heading: Timestamp
            }
            layout {
                sequence: 40
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column VIEW_MODE (
            type: plainText
            heading {
                heading: View Mode
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column VIEW_SINCE (
            type: plainText
            heading {
                heading: Viewed
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: M
            }
        )

        column VIEW_TYPE (
            type: plainText
            heading {
                heading: View Type
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Page Views
        }

        savedReport 438488 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ELAPSED (
                sequence: 4
            )

            displayColumn NUM_ROWS (
                sequence: 6
            )

            displayColumn PAGE_MODE (
                sequence: 5
            )

            displayColumn PAGE_NAME (
                sequence: 1
            )

            displayColumn SESSION_ID (
                sequence: 2
            )

            displayColumn VIEW_SINCE (
                sequence: 3
            )

            sort (
                column: TIMESTAMP
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    pageItem P30024_TIMEFRAME (
        type: selectList
        label {
            label: Timeframe
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @timeframe-4-weeks
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @button-bar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: item
            item: BLOG_DEFAULT_TIMEFRAME
        }
        sessionState {
            storage: user
        }
        security {
            encryptSessionState: false
            restrictedChars: alphanumWithSpace
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Reset Report
        layout {
            sequence: 20
            region: @page-views
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-report (
        name: Refresh Report
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P30024_TIMEFRAME
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @page-views
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

