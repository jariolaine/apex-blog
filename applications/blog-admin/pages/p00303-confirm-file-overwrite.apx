page 303 (
    name: Confirm File Overwrite
    alias: CONFIRM-FILE-OVERWRITE
    title: Confirm
    pageGroup: @files
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/wizard-modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 50
            slot: wizardButtons
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
            excludeTitleFromTranslation: true
        }
    )

    region confirm-message (
        name: Confirm Message
        type: staticContent
        source {
            htmlCode: &APP_TEXT$BLOG_CONFIRM_FILE_OVERWRITE.
        }
        layout {
            sequence: 60
            slot: wizardProgressBar
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--warning
                t-Alert--removeHeading js-removeLandmark
                margin-bottom-none
            ]
        }
        advanced {
            regionDisplaySelector: true
            excludeTitleFromTranslation: true
        }
    )

    region existing-file-s (
        name: Existing File(s)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                  c001 as file_path
                , c002 as file_desc
                from apex_collections
                where 1 = 1
                and collection_name = :BLOG_REPLACE_FILES_COLLECTION
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: wizardBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlightOff
                t-Report--inline
                t-Report--hideNoPagination
            ]
            showNullValuesAs: -
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column FILE_DESC (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Description
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column FILE_PATH (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Name
            }
            layout {
                sequence: 10
            }
            accessibility {
                valueIdentifiesRow: true
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P303_ACTION (
        type: hidden
        layout {
            sequence: 10
            region: @existing-file-s
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
            restrictedChars: alphanumWithSpace
        }
    )

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 30
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-chevron-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 302
            }
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @under-development
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-close
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    button save (
        buttonName: SAVE
        label: Replace File(s)
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: File(s) uploaded
        }
        advanced {
            executionMappingIdentifier: 21494412044945766
        }
    )

    process purge-public-application-files-page-cache (
        name: Purge Public Application Files Page Cache
        type: invokeApi
        invoke {
            package: APEX_UTIL
            procedureOrFunction: CACHE_PURGE_BY_PAGE
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 21494823250945766
        }

        parameter p_application (
            parameter {
                dataType: number
            }
            value {
                type: item
                item: G_PUB_APP_ID
            }
            advanced {
                displaySequence: 10
            }
        )

        parameter p_page (
            parameter {
                dataType: number
            }
            value {
                type: staticValue
                staticValue: 11
            }
            advanced {
                displaySequence: 30
            }
        )

    )

    process replace-file (
        name: Replace File
        type: invokeApi
        invoke {
            package: BLOG_FILE
            procedureOrFunction: REPLACE_FILE
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 22471901470556212
        }
        serverSideCondition {
            type: item=value
            item: P303_ACTION
            value: DB
        }
        comments {
            comments: Merge uploaded file(s) to database.
        }

        parameter p_collection_name (
            value {
                type: item
                item: BLOG_REPLACE_FILES_COLLECTION
            }
            advanced {
                displaySequence: 10
            }
        )

    )

    process replace-object (
        name: Replace Object
        type: invokeApi
        invoke {
            package: BLOG_OCI_OS
            procedureOrFunction: REPLACE_OBJECT
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 21493073667945768
        }
        serverSideCondition {
            type: item=value
            item: P303_ACTION
            value: OCI
        }
        comments {
            comments: Merge uploaded file(s) to database.
        }

        parameter p_client_request_id (
            parameter {
                hasDefault: true
            }
            value {
                type: apiDefault
            }
            advanced {
                displaySequence: 20
            }
        )

        parameter p_collection_name (
            value {
                type: item
                item: BLOG_REPLACE_FILES_COLLECTION
            }
            advanced {
                displaySequence: 10
            }
        )

    )

)

