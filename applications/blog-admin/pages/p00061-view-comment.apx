    region summary (
        name: Summary
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                  v1.sentiment              as sentiment
                , v1.sentiment_icon         as sentiment_icon
                , v1.sentiment_positive_pct as positive
                , v1.sentiment_neutral_pct  as neutral
                , v1.sentiment_negative_pct as negative
                , v1.sentiment_mixed_pct    as mixed
                from blog_v_all_comments v1
                where 1 = 1
                and v1.id = :P61_ID
                order by 1
                ```
            optimizerHint: APEX$USE_NO_PAGINATION
        }
        layout {
            sequence: 10
            parentRegion: @comment-sentiment
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--stacked
                t-Region--scrollBody
                margin-bottom-none
