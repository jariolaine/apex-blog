    button approve (
        buttonName: APPROVE
        label: Approve
        layout {
            sequence: 90
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconRight
            ]
            cssClasses: 62
            icon: fa-check
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: item=value
            item: P61_COMMENT_STATUS_CODE
            value: MODERATE
        }
    )

    button close (
        buttonName: CLOSE
        label: Close
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-close
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
    )

    button disable (
        buttonName: DISABLE
        label: Disable
        layout {
            sequence: 40
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-lock
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: item=value
            item: P61_COMMENT_STATUS_CODE
            value: ENABLED
        }
    )

    button edit (
        buttonName: EDIT
        label: Edit
        layout {
            sequence: 70
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
            icon: fa-pencil
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 62
                items: {
                    P62_ID: \&P61_ID.\
                }
                clearCache: 62
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button enable (
        buttonName: ENABLE
        label: Enable
        layout {
            sequence: 50
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-unlock
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: item=value
            item: P61_COMMENT_STATUS_CODE
            value: DISABLED
        }
    )

    button reply (
        buttonName: REPLY
        label: Reply
        layout {
            sequence: 80
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconRight
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 62
                clearCache: 62
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from blog_v_comments v1
                where 1 = 1
                and v1.parent_id is null
                and v1.comment_id = :P61_ID
                ```
        }
    )

    button unread (
        buttonName: UNREAD
        label: Mark as Unread
        layout {
            sequence: 30
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-envelope-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P61_PARENT_ID
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @close
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p61-is-active (
        itemName: P61_IS_ACTIVE
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: staticValue
            staticValue: 0
        }
        serverSideCondition {
            type: request=Value
            value: DISABLE
        }
        comments {
            comments: Disable comment.
        }
    )

    computation p61-is-active-2 (
        itemName: P61_IS_ACTIVE
        execution {
            sequence: 20
            point: afterSubmit
        }
        computation {
            type: staticValue
            staticValue: 1
        }
        serverSideCondition {
            type: request=Value
            value: ENABLE
        }
        comments {
            comments: Enable comment.
        }
    )

    computation p61-is-active-3 (
        itemName: P61_IS_ACTIVE
        execution {
            sequence: 30
            point: afterSubmit
        }
        computation {
            type: staticValue
            staticValue: 1
        }
        serverSideCondition {
            type: request=Value
            value: APPROVE
        }
        comments {
            comments: Enable comment when approving.
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 38590181651274302
        }
    )

    process flag-unread (
        name: Flag unread
        type: invokeApi
        invoke {
            package: BLOG_COMMENT
            procedureOrFunction: FLAG_COMMENT
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Comment marked as unread.
        }
        advanced {
            executionMappingIdentifier: 38193234448731805
        }
        serverSideCondition {
            whenButtonPressed: @unread
        }
        comments {
            comments: Set unread flag to comment.
        }

        parameter p_comment_id (
            value {
                type: item
                item: P61_ID
            }
            advanced {
                displaySequence: 10
            }
        )

        parameter p_flags (
            value {
                type: staticValue
                staticValue: UNREAD
            }
            advanced {
                displaySequence: 20
            }
        )

    )

    process initialize-form-comment (
        name: Initialize form Comment
        type: formInitialization
        formRegion: @comment
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 38184705007731789
        }
    )

    process process-form-comment (
        name: Process form Comment
        type: formAutoRowProcessing
        formRegion: @comment
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 38185137430731790
        }
    )

    process unflag-moderate (
        name: Unflag moderate
        type: invokeApi
        invoke {
            package: BLOG_COMMENT
            procedureOrFunction: UNFLAG_COMMENT
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Comment approved.
        }
        advanced {
            executionMappingIdentifier: 38191811002731801
        }
        serverSideCondition {
            whenButtonPressed: @approve
        }
