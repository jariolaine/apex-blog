page 61 (
    name: View Comment
    alias: VIEW-COMMENT
    title: Comment
    pageGroup: @comments
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region comment (
        name: Comment
        type: form
        source {
            location: localDatabase
            tableName: BLOG_V_FORM_COMMENTS
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
            lostUpdateType: rowVersionColumn
            rowVersionColumn: ROW_VERSION
        }
    )

    region comment-sentiment (
        name: Comment Sentiment
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                margin-top-none
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P61_SENTIMENT
        }
        config {
            buildOption: @blog-feature-language-ai
        }
    )

    region details (
        name: Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with qry as(
                  select
                    v1.sentiment_json
                  from blog_v_all_comments v1
                  where 1 = 1
                    and v1.id = :P61_ID
                )
                select 
                  j.sentiment
                , j.sentence
                , j.mixed * 100     as sentiment_mixed_pct
                , j.negative * 100  as sentiment_negative_pct
                , j.neutral * 100   as sentiment_neutral_pct
                , j.positive * 100  as sentiment_positive_pct
                from qry,
                json_table( qry.sentiment_json , '$.sentences[*]'
                  columns (
                    sentence path '$.text'
                  , sentence_order number path '$.offset'
                  , sentiment path '$.sentiment'
                  , mixed number path '$.scores.Mixed'
                  , negative number path '$.scores.Negative'
                  , neutral number path '$.scores.Neutral'
                  , positive number path '$.scores.Positive'
                  )
                ) j
                order by j.sentence_order
                ```
            optimizerHint: APEX$USE_NO_PAGINATION
        }
        layout {
            sequence: 20
            parentRegion: @comment-sentiment
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--stacked
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @blog-feature-language-ai
        }
        reportLayout {
            numberOfRows: 150
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlightOff
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }

        column SENTENCE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Sentence
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column SENTIMENT (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Sentiment
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            accessibility {
                valueIdentifiesRow: true
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {with/}
                    TEXT:=#SENTIMENT#
                    ICON_CLASSES:=fa-lg {case SENTIMENT/}
                    {when Mixed/}
                    fa-emoji-astonished u-info-text
                    {when Negative/}
                    fa-emoji-angry u-danger-text
                    {when Neutral/}
                    fa-emoji-neutral u-normal-text
                    {when Positive/}
                    fa-emoji-pleased u-success-text
                    {otherwise/}
                    fa-no-icon
                    {endcase/}
                    {apply THEME$ICON_CUSTOM/}
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column SENTIMENT_MIXED_PCT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Mixed %
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: 990D0
            }
            sorting {
                sortable: false
            }
        )

        column SENTIMENT_NEGATIVE_PCT (
            reportColumnQueryId: 4
            derivedColumn: N
