        }
        config {
            buildOption: @blog-feature-language-ai
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                t-BadgeList--large
                t-BadgeList--circular
                t-BadgeList--fixed
                t-Report--hideNoPagination
