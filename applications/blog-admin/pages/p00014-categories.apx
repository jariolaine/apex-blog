page 14 (
    name: Add/Edit Categories
    alias: CATEGORIES
    title: Categories
    pageGroup: @posts
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
            t-PageBody--noContentPadding
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region add-edit-categories (
        name: Add/Edit Categories
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: BLOG_V_ALL_CATEGORIES
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                margin-bottom-none
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            allowedRowOperationsColumn: ALLOWED_ROW_OPERATION
            lostUpdateType: rowVersionColumn
            rowVersionColumn: ROW_VERSION
            addRowIfEmpty: false
        }
        componentAppearance {
            showNullValuesAs: -
            selectFirstRow: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            defineChartView: false
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
            sendAsEmail: false
            filename: blog-categories
            supplementalText: &P0_BLOG_APP_NAME!RAW. categories.
        }
        heading {
            fixedTo: region
            fixedReportHeight: 440
        }
        componentAdvanced {
            initJavaScriptFunction: blog.admin.ig.region
        }
        advanced {
            savedReportMappingIdentifier: 15190504448050377
        }

        savedReport 249317 (
            visibility: primary
            view {
                default: grid
                rowsPerPage: 20
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @TITLE
                layout {
                    width: 179
                    sequence: 4
                }
            )

            displayColumn (
                column: @POSTS_COUNT
                layout {
                    width: 58
                    sequence: 5
                }
            )

            displayColumn (
                column: @ALLOWED_ROW_OPERATION
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @IS_ACTIVE
                layout {
                    width: 83
                    sequence: 7
                }
            )

            displayColumn (
                column: @DISPLAY_SEQ
                layout {
                    width: 92
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 42
                    sequence: 1
                }
            )

            displayColumn (
                column: @ROW_VERSION
                layout {
                    show: false
                    sequence: 8
                }
            )

            displayColumn (
                column: @CREATED_ON
                layout {
                    show: false
                    sequence: 11
                }
            )

            displayColumn (
                column: @CREATED_BY
                layout {
                    show: false
                    sequence: 12
                }
            )

            displayColumn (
                column: @CHANGED_ON
                layout {
                    show: false
                    sequence: 13
                }
            )

            displayColumn (
                column: @CHANGED_BY
                layout {
                    show: false
                    sequence: 14
                }
            )

            displayColumn (
                column: @NOTES
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @VIEW_POSTS_LINK
                layout {
                    width: 42
                    sequence: 9
                }
            )

            sort (
                column: @DISPLAY_SEQ
                sort {
                    nulls: last
                    sequence: 1
                }
            )

        )

        column ALLOWED_ROW_OPERATION (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: ALLOWED_ROW_OPERATION
                dataType: varchar2
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CHANGED_BY (
            type: displayOnly
            heading {
                heading: Changed by
            }
            layout {
                sequence: 120
            }
            source {
                databaseColumn: CHANGED_BY
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                controlBreakAggregate: false
            }
            help {
                helpText: Who has changed category last.
            }
        )

        column CHANGED_ON (
            type: displayOnly
            heading {
                heading: Changed on
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                databaseColumn: CHANGED_ON
                dataType: timestampWithLocalTimeZone
                queryOnly: true
            }
            enableUsersTo {
                controlBreakAggregate: false
            }
            help {
                helpText: When category was last changed.
            }
        )

        column CREATED_BY (
            type: displayOnly
            heading {
                heading: Created by
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: CREATED_BY
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                controlBreakAggregate: false
            }
            help {
                helpText: Who created category.
            }
        )

        column CREATED_ON (
            type: displayOnly
            heading {
                heading: Created on
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: CREATED_ON
                dataType: timestampWithLocalTimeZone
                queryOnly: true
            }
            enableUsersTo {
                controlBreakAggregate: false
            }
            help {
                helpText: When category was created.
            }
        )

        column DISPLAY_SEQ (
            type: numberField
            heading {
                heading: Sequence
                alignment: end
            }
            settings {
                virtualKeyboard: numeric
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DISPLAY_SEQ
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            enableUsersTo {
                controlBreakAggregate: false
            }
            help {
                helpText: Order of categories displayed in blog.
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IS_ACTIVE (
            type: switch
            heading {
                heading: Status
                alignment: center
            }
            settings {
                useDefaults: false
                onValue: 1
                onLabel: Enabled
                offValue: 0
                offLabel: Disabled
            }
            layout {
                sequence: 160
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IS_ACTIVE
                dataType: number
            }
            default {
                type: static
                staticValue: 1
            }
            columnFilter {
                lovType: useLov
            }
            enableUsersTo {
                controlBreakAggregate: false
                hide: false
            }
            help {
                helpText: Is category enabled or disabled. If you disable existing category, it will hide all post in this category from readers. Also category is not available anymore in "Category" field search when creating or changing post. Still you can use disabled category by typing it e.g. for new post. Post will not be visible for reades until you activate category or change post category one that is enabled.
            }
        )

        column NOTES (
            type: textarea
            heading {
                heading: Notes
            }
            layout {
                sequence: 150
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: NOTES
                dataType: varchar2
            }
            default {
                duplicateCopiesExistingValue: false
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                controlBreakAggregate: false
                hide: false
            }
            help {
                helpText: Enter any comments or notes here. These notes not displayed for public.
            }
        )

        column POSTS_COUNT (
            type: displayOnly
            heading {
                heading: Posts
                alignment: center
            }
            layout {
                sequence: 170
                columnAlignment: center
            }
            source {
                databaseColumn: POSTS_COUNT
                dataType: number
                queryOnly: true
            }
            enableUsersTo {
                controlBreakAggregate: false
                hide: false
            }
            help {
                helpText: Number of post in this category.
            }
        )

        column ROW_VERSION (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ROW_VERSION
                dataType: number
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column TITLE (
            type: textField
            heading {
                heading: Title
            }
            layout {
                sequence: 140
                stretch: always
            }
            accessibility {
                valueIdentifiesRow: true
            }
            validation {
                valueRequired: true
                maxLength: 256
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                ]
                lovType: none
            }
            enableUsersTo {
                controlBreakAggregate: false
                hide: false
            }
            help {
                helpText: Describes what your category is about.
            }
        )

        column VIEW_POSTS_LINK (
            type: link
            heading {
                alignment: center
                alternativeLabel: Link to Posts
            }
            layout {
                sequence: 180
                columnAlignment: center
            }
            link {
                target: {
                    page: 11
                    items: {
                        IR_CATEGORY_ID: &ID.
                    }
                    action: clearRegions
                }
                linkText: <span aria-hidden="true" class="t-Icon fa fa-external-link"></span>
                linkAttributes: title="&APP_TEXT$BLOG_TXT_VIEW_POSTS." class="t-Button--stretch"
            }
            source {
                type: none
            }
            help {
                helpText: Filter posts report by this category.
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
            excludeTitleFromTranslation: true
        }
    )

    button add-row (
        buttonName: ADD_ROW
        label: Add Row
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectUrl
            targetUrl: #action$selection-add-row
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            customAttributes: data-action="selection-add-row" data-no-update="true"
        }
    )

    button close (
        buttonName: CLOSE
        label: Close
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-close
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    button delete-unused (
        buttonName: DELETE_UNUSED
        label: Delete Unused
        layout {
            sequence: 40
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
            icon: fa-trash-o
        }
        behavior {
            action: definedByDynamicAction
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$BLOG_CONFIRM_DELETE_UNUSED_CATEGORIES.
            style: danger
        }
    )

    button resequence-categories (
        buttonName: RESEQUENCE_CATEGORIES
        label: Resequence
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-sequence
        }
        behavior {
            action: definedByDynamicAction
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$BLOG_CONFIRM_RESEQUENCE_CATEGORIES.
            style: warning
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconRight
            ]
            icon: fa-save
        }
        behavior {
            action: redirectUrl
            targetUrl: #action$save
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            customAttributes: data-action="save" data-no-update="true"
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @close
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unused (
        name: Delete unused
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @delete-unused
        }

        action delete-categories (
            name: Delete categories
            action: executeServerSideCode
            settings {
                plsqlCode: blog_admin.remove_unused_categories;
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            comments {
                comments: Call database procedure to delete categories that aren't used in any post.
            }
        )

        action refresh-ig (
            name: Refresh IG
            action: refresh
            affectedElements {
                selectionType: region
                region: @add-edit-categories
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action show-message (
            name: Show message
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    blog.admin.showSuccessMessage({
                      "text": "BLOG_MSG_CATEGORIES_UNUSED_DELETED"
                    });
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

    dynamicAction process-after-changes (
        name: Process After Changes
        execution {
            sequence: 20
        }
        when {
            event: region/interactiveGrid/interactivegridsave
            selectionType: region
            region: @add-edit-categories
        }

        action purge-public-application-global-page-cache (
            name: Purge public application global page cache
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    apex_util.cache_purge_by_page(
                       p_application => :G_PUB_APP_ID
                      ,p_page => 0
                    );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
                waitForResult: false
            }
            comments {
                comments: Purge public application global page regions cache.
            }
        )

    )

    dynamicAction resequence (
        name: Resequence
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @resequence-categories
        }

        action refresh-ig (
            name: Refresh IG
            action: refresh
            affectedElements {
                selectionType: region
                region: @add-edit-categories
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action resequence-categories (
            name: Resequence categories
            action: executeServerSideCode
            settings {
                plsqlCode: blog_admin.resequence_categories;
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action show-message (
            name: Show message
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    blog.admin.showSuccessMessage({
                      "text": "BLOG_MSG_CATEGORIES_RESEQUENCED"
                    });
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    process categories-save-ig-data (
        name: Categories - Save IG Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @add-edit-categories
        target {
            targetType: tableView
            tableName: BLOG_CATEGORIES
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 4069842441688345
        }
    )

)

