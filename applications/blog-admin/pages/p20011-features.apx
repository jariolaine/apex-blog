page 20011 (
    name: Features
    alias: FEATURES
    title: Features
    pageGroup: @configuration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
            js-dialog-class-t-Drawer--pullOutEnd
            js-dialog-class-t-Drawer--lg
            t-PageBody--noContentPadding
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
            excludeTitleFromTranslation: true
        }
    )

    region features (
        name: Features
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: BLOG_V_FEATURES
            whereClause: application_id = :G_PUB_APP_ID
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                margin-bottom-none
            ]
            cssClasses: blog-config-ig
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
            selectFirstRow: false
        }
        pagination {
            type: page
            showTotalCount: false
        }
        toolbar {
            show: false
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        heading {
            fixedTo: none
        }
        componentAdvanced {
            initJavaScriptFunction: blog.admin.ig.region
        }
        advanced {
            savedReportMappingIdentifier: 27063837092689139
        }

        savedReport 249339 (
            visibility: primary
            view {
                default: grid
                rowsPerPage: 1000
                settingsAreaExpanded: false
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @FEATURE_GROUP_HTML
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @APPLICATION_ID
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @HELP_LINK
                layout {
                    width: 50
                    sequence: 5
                }
            )

            displayColumn (
                column: @BUILD_OPTION_PARENT
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @FEATURE_DESC
                layout {
                    width: 260
                    sequence: 3
                }
            )

            displayColumn (
                column: @LAST_UPDATED_BY
                layout {
                    width: 140
                    sequence: 11
                }
            )

            displayColumn (
                column: @BUILD_OPTION_ID
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @DISPLAY_SEQ
                layout {
                    show: false
                    sequence: 1
                }
            )

            displayColumn (
                column: @BUILD_OPTION_STATUS
                layout {
                    width: 60
                    sequence: 4
                }
            )

            displayColumn (
                column: @ID
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @LAST_UPDATED_ON
                layout {
                    width: 100
                    sequence: 6
                }
            )

            displayColumn (
                column: @BUILD_OPTION_LEVEL
                layout {
                    sequence: 13
                }
            )

            displayColumn (
                column: @IS_PARENT
                layout {
                    sequence: 12
                }
            )

            sort (
                column: @FEATURE_GROUP_HTML
                sort {
                    nulls: last
                    sequence: 1
                }
            )

            sort (
                column: @DISPLAY_SEQ
                sort {
                    nulls: last
                    sequence: 2
                }
            )

            controlBreak (
                column: @FEATURE_GROUP_HTML
                sort {
                    nulls: last
                }
                layout {
                    sequence: 5
                }
            )

        )

        column APPLICATION_ID (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: APPLICATION_ID
                dataType: number
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column BUILD_OPTION_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: BUILD_OPTION_ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column BUILD_OPTION_LEVEL (
            type: hidden
            layout {
                sequence: 160
            }
            source {
                databaseColumn: BUILD_OPTION_LEVEL
                dataType: number
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column BUILD_OPTION_PARENT (
            type: hidden
            layout {
                sequence: 120
            }
            source {
                databaseColumn: BUILD_OPTION_PARENT
                dataType: varchar2
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column BUILD_OPTION_STATUS (
            type: switch
            heading {
                heading: Status
                alignment: center
            }
            settings {
                useDefaults: false
                onValue: Include
                onLabel: Enabled
                offValue: Exclude
                offLabel: Disabled
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: BUILD_OPTION_STATUS
                dataType: varchar2
            }
            columnFilter {
                enabled: false
            }
            enableUsersTo {
                sort: false
                hide: false
            }
        )

        column DISPLAY_SEQ (
            type: displayOnly
            heading {
                heading: Sequence
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
                stretch: always
            }
            source {
                databaseColumn: DISPLAY_SEQ
                dataType: number
                queryOnly: true
            }
            columnFilter {
                enabled: false
            }
            enableUsersTo {
                hide: false
            }
        )

        column FEATURE_DESC (
            type: htmlExpression
            heading {
                heading: Name
            }
            settings {
                htmlExpression:
                    ```html
                    <span class="blog-feature-level&BUILD_OPTION_LEVEL."{if IS_PARENT/} data-status="&BUILD_OPTION_STATUS."{endif/}>&FEATURE_DESC.</span>
                    
                    ```
            }
            layout {
                sequence: 50
                stretch: always
            }
            accessibility {
                valueIdentifiesRow: true
            }
            appearance {
                cssClasses: padding-left-md
            }
            source {
                databaseColumn: FEATURE_DESC
                dataType: varchar2
                queryOnly: true
            }
            enableUsersTo {
                sort: false
                hide: false
            }
        )

        column FEATURE_GROUP_HTML (
            type: displayOnly
            heading {
                heading: Group
            }
            settings {
                format: html
            }
            layout {
                sequence: 60
                stretch: always
            }
            source {
                databaseColumn: FEATURE_GROUP_HTML
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                enabled: false
            }
            enableUsersTo {
                hide: false
            }
        )

        column HELP_LINK (
            type: link
            heading {
                heading: Help
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            link {
                target: {
                    page: 20100
                    items: {
                        P20100_ID: &ID.
                    }
                    request: FEATURES
                }
                linkText: <span aria-hidden="true" class="t-Icon fa fa-question-circle-o"></span>
                linkAttributes: title="&APP_TEXT$BLOG_TXT_HELP." aria-label="&APP_TEXT$BLOG_TXT_HELP." class="t-Button t-Button--noLabel t-Button--icon t-Button--link t-Button--stretch padding-none"
            }
            source {
                type: none
            }
            enableUsersTo {
                hide: false
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ID
                dataType: number
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IS_PARENT (
            type: hidden
            layout {
                sequence: 140
            }
            source {
                databaseColumn: IS_PARENT
                dataType: varchar2
                queryOnly: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column LAST_UPDATED_BY (
            type: displayOnly
            heading {
                heading: Changed by
            }
            layout {
                sequence: 110
                stretch: always
            }
            source {
                databaseColumn: LAST_UPDATED_BY
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                enabled: false
            }
            enableUsersTo {
                sort: false
                hide: false
            }
        )

        column LAST_UPDATED_ON (
            type: displayOnly
            heading {
                heading: Changed
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            appearance {
                formatMask: SINCE
            }
            source {
                databaseColumn: LAST_UPDATED_ON
                dataType: date
                queryOnly: true
            }
            columnFilter {
                enabled: false
            }
            enableUsersTo {
                sort: false
                hide: false
            }
        )

    )

    button close (
        buttonName: CLOSE
        label: Close
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-close
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-save
        }
        behavior {
            action: redirectUrl
            targetUrl: #action$save
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            customAttributes: data-action="save" data-no-update="true"
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @close
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction process-after-changes (
        name: Process After Changes
        execution {
            sequence: 20
        }
        when {
            event: region/interactiveGrid/interactivegridsave
            selectionType: region
            region: @features
        }

        action clear-public-application-global-page-cached-regions (
            name: Clear public application global page cached regions
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    apex_util.cache_purge_by_page(
                       p_application => :G_PUB_APP_ID
                      ,p_page => 0
                    );
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
                waitForResult: false
            }
            clientSideCondition {
                type: jsExpression
                javaScriptExpression: this.data.status === "success"
            }
        )

        action hide-child-features (
            name: Hide Child Features
            action: executeJsCode
            settings {
                jsCode: blog.admin.ig.processChildFeatures( this.triggeringElement );
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction process-status-change (
        name: Process  Status Change
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @features
            columns: BUILD_OPTION_STATUS
        }

        action hide-child-features (
            name: Hide Child Features
            action: executeJsCode
            settings {
                jsCode: blog.admin.ig.processChildFeatures( this.triggeringElement );
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: "apex.region( this.affectedElements[0].id ).call( \"getActions\" ).invoke( \"save\" );"
            }
            affectedElements {
                selectionType: region
                region: @features
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            config {
                buildOption: @commented-out
            }
        )

    )

    process features-save-interactive-grid-data (
        name: Features - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @features
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                blog_admin.update_feature(
                  p_app_id          => :APPLICATION_ID
                , p_build_option_id => :BUILD_OPTION_ID
                , p_build_status    => :BUILD_OPTION_STATUS
                );
                ```
        }
        lockRow {
            lockRow: false
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Changes saved
        }
        advanced {
            executionMappingIdentifier: 27064721351689148
        }
        comments {
            comments: Update build option value and run post expression
        }
    )

)

