            }
            appearance {
                formatMask: 999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column PARTIAL_PAGE_VIEWS (
            type: plainText
            heading {
                heading: Partial Page Views
                alignment: end
            }
            layout {
                sequence: 115
