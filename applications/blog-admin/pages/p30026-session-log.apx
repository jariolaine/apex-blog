            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column VIEW_SINCE (
            type: plainText
            heading {
                heading: Logged
                alignment: center
            }
            layout {
                sequence: 240
                columnAlignment: center
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AC
            }
        )

        column VIEW_TIMESTAMP (
            type: plainText
            heading {
                heading: Timestamp
            }
            layout {
                sequence: 230
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AA
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Session Log
        }

        savedReport 196594 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AGENT (
                sequence: 6
            )

            displayColumn ECID (
                sequence: 7
            )

            displayColumn ELAPSED_TIME (
                sequence: 3
            )

            displayColumn IP_ADDRESS (
                sequence: 5
            )

            displayColumn PAGE_NAME (
                sequence: 1
            )

            displayColumn ROWS_QUERIED (
                sequence: 4
            )

            displayColumn VIEW_SINCE (
                sequence: 2
            )

            sort (
                column: VIEW_TIMESTAMP
                sort {
                    sequence: 1
                }
            )

            sort (
                column: SECONDS_AGO
                sort {
                    sequence: 2
                }
            )

        )

    )

    pageItem P30026_APEX_SESSION_ID (
        type: hidden
        layout {
            sequence: 10
            region: @session-log
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
            restrictedChars: alphanumWithSpace
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Reset Report
        layout {
            sequence: 20
            region: @session-log
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

