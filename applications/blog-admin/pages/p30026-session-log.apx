            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column IR_SAVED_REPORT_ID (
            type: hidden
            heading {
                heading: Ir Saved Report Id
            }
            layout {
                sequence: 160
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column IR_SEARCH (
            type: hidden
            heading {
                heading: Ir Search
            }
            layout {
                sequence: 170
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column LOG_CONTEXT (
            type: plainText
            heading {
                heading: Log Context
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column PAGE (
            type: plainText
            heading {
                heading: Page
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AD
            }
        )

        column PAGE_NAME (
            type: plainText
            heading {
                heading: Page Name
            }
            layout {
                sequence: 20
            }
            accessibility {
                valueIdentifiesRow: true
            }
            columnFormatting {
                htmlExpression: #PAGE#. #PAGE_NAME#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column PAGE_VIEW_MODE (
