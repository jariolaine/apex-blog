            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column ERROR_ON_COMPONENT_NAME (
            type: plainText
            heading {
                heading: Error on Component Name
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column ERROR_ON_COMPONENT_TYPE (
            type: plainText
            heading {
                heading: Error on Component Type
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column INTERACTIVE_REPORT_ID (
