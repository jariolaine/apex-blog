            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Y
            }
        )

        column ROWS_QUERIED (
            type: plainText
            heading {
                heading: Rows Queried
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column THINK_TIME (
            type: plainText
            heading {
                heading: Think Time
                alignment: end
            }
            layout {
