page 202 (
    name: About This Application
    alias: ABOUT-THIS-APPLICATION
    title: About This Application
    pageGroup: @general
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
            ]
            cssClasses: u-textCenter
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region patches (
        name: Patches
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                   t1.attribute_value as attribute_value
                  ,t1.created_on      as created_on
                from blog_settings t1
                where 1 = 1
                  and t1.attribute_name like 'PATCH%'
                order by t1.created_on desc
                ```
            optimizerHint: APEX$USE_NO_PAGINATION
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--stacked
                t-Region--scrollBody
            ]
            renderComponents: belowContent
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlightOff
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        pagination {
            partialPageRefresh: false
        }

        column ATTRIBUTE_VALUE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Patch No.
            }
            layout {
                sequence: 10
            }
            accessibility {
                valueIdentifiesRow: true
            }
            sorting {
                sortable: false
            }
        )

        column CREATED_ON (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Applied
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

    )

    region version (
        name: Version
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                   t1.attribute_value as attribute_value
                  ,t1.changed_on      as changed_on
                from blog_settings t1
                where 1 = 1
                  and t1.attribute_name = 'G_APP_VERSION'
                order by 1
                ```
            optimizerHint: APEX$USE_NO_PAGINATION
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--stacked
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 1
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlightOff
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        pagination {
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 1
        }

        column ATTRIBUTE_VALUE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Version
            }
            layout {
                sequence: 30
            }
            accessibility {
                valueIdentifiesRow: true
            }
            sorting {
                sortable: false
            }
        )

        column CHANGED_ON (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Changed On
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

    )

    button close (
        buttonName: CLOSE
        label: Close
        layout {
            sequence: 10
            region: @buttons
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            cssClasses: [
                w40p
                mxw240
            ]
            icon: fa-close
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @close
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

