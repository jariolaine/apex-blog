page 12 (
    name: Add/Edit Post
    alias: POST-PROPERTIES
    title: Post
    pageGroup: @posts
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigationMenu {
        overrideUserInterfaceLevel: true
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <h2>
              Create, edit, manage or delete a post
            </h2>
            <h3>
              Write a new post
            </h3>
            <ol>
              <li>
                Click New Post.
              </li>  
              <li>
                Create the post. Use editor options to format post. E.g. in "Styles" select list you find block style "Program Code" that is useful when posting code.
              </li>
              <li>
                To save your post without publishing it, click Save Draf. To publish your post, click Publish.
              </li>
            </ol>
            <h3>
              Edit a post
            </h3>
            <ol>
              <li>
                Click edit button on post you want to edit.
              </li>
              <li>
                Make your changes.
              </li>
              <li>
                Click Save.
              </li>
            </ol>
            <h3>
              Delete a post  
            </h3>
            <ol>
              <li>
                Click edit button on post you want to delete.
              </li>
              <li>
                Click Delete.
              </li>
            </ol>
            
            ```
    }

    region ai-assistant-buttons (
        name: AI Assistant Buttons
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @assistant
            slot: subRegions
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noBorder
                margin-bottom-none
            ]
            cssClasses: blog-assistant-buttons
        }
        config {
            buildOption: @blog-feature-generative-ai
        }
    )

    region assistant (
        name: Assistant
        type: staticContent
        source {
            htmlCode: <div id="blog-ai-assistant"></div>
        }
        layout {
            sequence: 30
            parentRegion: @post-content
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: [
                blog-assistant
                blog-region-noItemHelp
            ]
        }
        config {
            buildOption: @blog-feature-generative-ai
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 50
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
                t-Form--noPadding
                margin-top-none
                margin-bottom-none
            ]
        }
        advanced {
            regionDisplaySelector: true
            excludeTitleFromTranslation: true
        }
    )

    region changes (
        name: Changes
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_ID
        }
        config {
            buildOption: @under-development
        }
    )

    region post-content (
        name: Post Content
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
            columnSpan: 8
            columnCssClasses: padding-right-none
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region post-properties (
        name: Post Properties
        type: form
        source {
            location: localDatabase
            tableName: BLOG_V_FORM_POSTS
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowVersionColumn
            rowVersionColumn: ROW_VERSION
        }
    )

    pageItem P12_BLOGGER_ID (
        type: hidden
        layout {
            sequence: 30
            region: @post-properties
            slot: regionBody
        }
        source {
            formRegion: @post-properties
            column: BLOGGER_ID
            dataType: number
        }
        default {
            type: item
            item: G_BLOGGER_ID
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
            restrictedChars: alphanumWithSpace
        }
    )

    pageItem P12_BODY_HTML (
        type: richTextEditor
        label {
            label: Post Editor
            alignment: left
        }
        settings {
            format: html
            toolbar: full
            minHeight: 320
            allowCustomHtml: true
        }
        layout {
            sequence: 40
            region: @post-content
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--postTextBlock
                margin-bottom-none
            ]
            cssClasses: [
                padding-bottom-none
                blog-item
            ]
        }
        validation {
            valueRequired: true
        }
        advanced {
            postText: "\"BLOG_BTN_POST_BODY\""
            initJavaScriptFunction: blog.admin.editor.init
        }
        source {
            formRegion: @post-properties
            column: BODY_HTML
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
        }
        help {
            helpText: Refer online document <a target="_blank" href="https://ckeditor.com/docs/ckeditor5/latest/features/basic-styles.html">Basic Text Styles: Bold, Italic and More</a> how style your post.
        }
    )

    pageItem P12_CATEGORY_ID (
        type: hidden
        layout {
            sequence: 50
            region: @post-properties
            slot: regionBody
        }
        source {
            formRegion: @post-properties
            column: CATEGORY_ID
            dataType: number
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
            restrictedChars: alphanumWithSpace
        }
    )

    pageItem P12_CATEGORY_TITLE (
        type: popupLov
        label {
            label: Category
            alignment: left
        }
        settings {
            manualEntry: true
        }
        lov {
            type: sharedComponent
            lov: @categories
        }
        layout {
            sequence: 110
            region: @post-properties
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--postTextBlock
            ]
            cssClasses: blog-item
            width: 30
        }
        validation {
            maxLength: 256
        }
        advanced {
            postText: "\"BLOG_BTN_POST_CATEGORY\""
        }
        source {
            formRegion: @post-properties
            column: CATEGORY_TITLE
            dataType: varchar2
            queryOnly: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
            restrictedChars: webSafe
        }
        help {
            helpText: Categories are case insensitive unique. Example, if you enter "my category" and there is already category "My Category", later will be used as post category. Use search to find existing categories. You can maintain categories information by clicking <em>Categories</em> tab at Posts page.
        }
    )

    pageItem P12_CHANGE_NOTE (
        type: textField
        label {
            label: Change Notes
            alignment: left
        }
        layout {
            sequence: 20
            region: @changes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
        }
        help {
            helpText: If you edit existing post, you can add comments to version. This attribute is available only after you first time save post.
        }
        config {
            buildOption: @under-development
        }
    )

    pageItem P12_FIRST_PARAGRAPH (
        type: hidden
        layout {
            sequence: 70
            region: @post-properties
            slot: regionBody
        }
        source {
            formRegion: @post-properties
            column: FIRST_PARAGRAPH
            dataType: varchar2
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
        }
    )

    pageItem P12_ID (
        type: hidden
        layout {
            sequence: 10
            region: @post-properties
            slot: regionBody
        }
        source {
            formRegion: @post-properties
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
            restrictedChars: alphanumWithSpace
        }
    )

    pageItem P12_IS_ACTIVE (
        type: hidden
        layout {
            sequence: 60
            region: @post-properties
            slot: regionBody
        }
        source {
            formRegion: @post-properties
            column: IS_ACTIVE
            dataType: number
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
            restrictedChars: alphanumWithSpace
        }
    )

    pageItem P12_NOTES (
        type: textarea
        label {
            label: Notes
            alignment: left
        }
        settings {
            autoHeight: true
        }
        layout {
            sequence: 180
            region: @post-properties
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            cssClasses: [
                blog-item
                blog-noItemHelp
            ]
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @post-properties
            column: NOTES
            dataType: varchar2
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
        }
        help {
            inlineHelpText: Enter any comments or notes here. These notes not displayed for public.
        }
    )

    pageItem P12_POST_DESC (
        type: textarea
        label {
            label: Summary
            alignment: left
        }
        settings {
            autoHeight: true
        }
        layout {
            sequence: 80
            region: @post-properties
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--postTextBlock
            ]
            cssClasses: [
                blog-item
                blog-postText
            ]
            height: 6
        }
        validation {
            valueRequired: true
            maxLength: 1024
        }
        advanced {
            postText: "\"BLOG_BTN_POST_DESCRIPTION\""
        }
        source {
            formRegion: @post-properties
            column: POST_DESC
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
        help {
            helpText: Short description of post. Description is used in search results and RSS feed. Whitespaces other than spaces are removed when you save post.
        }
    )

    pageItem P12_PUBLISHED_DISPLAY (
        type: displayOnly
        label {
            label: Published on
            alignment: left
        }
        settings {
            showLineBreaks: false
            sendOnPageSubmit: false
        }
        layout {
            sequence: 160
            region: @post-properties
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: &P501_DISPLAY_DATE_FORMAT.
        }
        source {
            type: item
            item: P12_PUBLISHED_ON
        }
        sessionState {
            storage: request
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_PUBLISHED_ON
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
        }
        help {
            helpText: Date when post was/will be published.
        }
    )

    pageItem P12_PUBLISHED_ON (
        type: datePicker
        label {
            label: Set Published on
            alignment: left
        }
        settings {
            showTime: true
        }
        layout {
            sequence: 170
            region: @post-properties
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: &P501_INPUT_DATE_FORMAT.
            width: 30
        }
        source {
            formRegion: @post-properties
            column: PUBLISHED_ON
            dataType: timestampWithLocalTimeZone
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
        }
        help {
            helpText: Date when post will be published.
        }
    )

    pageItem P12_ROW_VERSION (
        type: hidden
        layout {
            sequence: 20
            region: @post-properties
            slot: regionBody
        }
        source {
            formRegion: @post-properties
            column: ROW_VERSION
            dataType: number
            queryOnly: true
        }
        default {
            type: item
            item: G_BLOGGER_ID
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
            restrictedChars: alphanumWithSpace
        }
    )

    pageItem P12_SCHEDULE (
        type: switch
        label {
            label: Schedule
            alignment: left
        }
        layout {
            sequence: 150
            region: @post-properties
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
        }
        help {
            helpText: Enable editing publsih date.
        }
    )

    pageItem P12_TAGS (
        type: popupLov
        label {
            label: Tags
            alignment: left
        }
        settings {
            manualEntry: true
            fetchOnSearch: true
        }
        lov {
            type: sharedComponent
            lov: @post-tags
            displayNullValue: false
        }
        multipleValues {
            type: delimitedList
            separator: ,
        }
        layout {
            sequence: 130
            region: @post-properties
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--postTextBlock
            ]
            cssClasses: blog-item
            width: 30
        }
        validation {
            maxLength: 32767
        }
        advanced {
            postText: "\"BLOG_BTN_POST_TAGS\""
        }
        source {
            formRegion: @post-properties
            column: TAGS
            dataType: varchar2
            queryOnly: true
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
            restrictedChars: webSafe
        }
        help {
            helpText:
                ```html
                Comma separated list of tags. 
                Tags are case insensitive unique. 
                Example, if you enter "my tag" and there is already tag "My Tag",
                later will be used as tag. 
                Use search to find existing tags. 
                You can maintain  all tags information by clicking <em>All Tags</em> tab at Posts page. To edit e.g. display sequence of tags linked to post, click <em>Edit Tags</em> button on Posts page report.
                ```
        }
    )

    pageItem P12_TITLE (
        type: textField
        label {
            label: Title
            alignment: left
        }
        layout {
            sequence: 20
            region: @post-content
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--postTextBlock
            ]
            cssClasses: blog-item
        }
        validation {
            valueRequired: true
            maxLength: 256
        }
        advanced {
            postText: "\"BLOG_BTN_POST_TITLE\""
        }
        source {
            formRegion: @post-properties
            column: TITLE
            dataType: varchar2
        }
        security {
            sessionStateProtection: restricted
            encryptSessionState: false
        }
        help {
            helpText: Describes what your post is about.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-chevron-left
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    button create (
        buttonName: CREATE
        label: Publish
        layout {
            sequence: 80
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        advanced {
            htmlDomId: CREATE
        }
        serverSideCondition {
            type: itemIsNull
            item: P12_ID
        }
    )

    button create-draft (
        buttonName: CREATE_DRAFT
        label: Save Draft
        layout {
            sequence: 70
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconRight
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P12_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 10
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_ID
        }
    )

    button reset-chat (
        buttonName: RESET_CHAT
        label: Reset Chat
        layout {
            sequence: 10
            region: @ai-assistant-buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-undo
        }
        behavior {
            action: definedByDynamicAction
        }
        config {
            buildOption: @blog-feature-generative-ai
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 60
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: item=value
            item: P12_IS_ACTIVE
            value: 1
        }
    )

    button save-and-publish (
        buttonName: SAVE_AND_PUBLISH
        label: Publish
        layout {
            sequence: 40
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: item=value
            item: P12_IS_ACTIVE
            value: 0
        }
    )

    button save-draft (
        buttonName: SAVE_DRAFT
        label: Save Draft
        layout {
            sequence: 30
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconRight
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: item=value
            item: P12_IS_ACTIVE
            value: 0
        }
    )

    button save-revert-to-draft (
        buttonName: SAVE_REVERT_TO_DRAFT
        label: Revert to Draft
        layout {
            sequence: 50
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconRight
            ]
            icon: fa-undo
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: item=value
            item: P12_IS_ACTIVE
            value: 1
        }
    )

    button talk-to-assistant (
        buttonName: TALK_TO_ASSISTANT
        label: Talk to Assistant
        layout {
            sequence: 30
            region: @ai-assistant-buttons
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-microphone
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
        advanced {
            htmlDomId: TALK_TO_ASSISTANT
        }
        config {
            buildOption: @blog-feature-post-speech
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction generative-ai-buttons (
        name: Generative AI Buttons
        execution {
            sequence: 110
        }
        when {
            event: ready
        }
        config {
            buildOption: @blog-feature-generative-ai
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    blog.admin.ai.post.buttonActions();
                    
                    
                    ```
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction post-speech-recognition-button (
        name: Post Speech Recognition Button
        execution {
            sequence: 120
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: "webkitSpeechRecognition" in window
        }

        action remove-button (
            name: Remove Button
            action: executeJsCode
            settings {
                jsCode: this.affectedElements.siblings( ".t-Form-itemText--post" ).has( ":button" ).remove();
            }
            affectedElements {
                selectionType: items
                items: P12_BODY_HTML
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action set-speech-recognition (
            name: Set Speech Recognition
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    blog.admin.speechRecognition.initButtonAction({
                      element$: this.affectedElements
                    , objectName: "post"
                    , action: "record-post"
                    , class: [ "u-warning-text" ]
                    });
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P12_BODY_HTML
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction process-schedule (
        name: Process Schedule
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P12_SCHEDULE
        }
        clientSideCondition {
            type: item=value
            item: P12_SCHEDULE
            value: Y
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @save-draft
            }
            execution {
                sequence: 30
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @create-draft
            }
            execution {
                sequence: 40
            }
        )

        action native-disable-3 (
            action: disable
            affectedElements {
                selectionType: button
                button: @save-revert-to-draft
            }
            execution {
                sequence: 50
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @save-draft
            }
            execution {
                sequence: 40
