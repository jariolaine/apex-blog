    process process-category (
        name: Process Category
        type: invokeApi
        invoke {
            package: BLOG_ADMIN
            procedureOrFunction: ADD_CATEGORY
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 6929777493150993
        }
        serverSideCondition {
            type: request!=Value
            value: DELETE
        }
        comments {
            comments: Add new category if not exists and get category id. If category exists return category id. Run only when post is inserted or updated.
        }

        parameter p_category_id (
            parameter {
                direction: out
                dataType: number
            }
            value {
                item: P12_CATEGORY_ID
            }
            advanced {
                displaySequence: 20
            }
        )

        parameter p_category_title (
