    dynamicAction set-ai-assistant (
        name: Set AI Assistant
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @reset-chat
        }
        config {
            buildOption: @blog-feature-generative-ai
        }

        action initialize-open-ai-assistant (
            name: Initialize Open AI Assistant
            action: showAiAssistant
            genAI {
                service: @BLOG_OPEN_AI_API
                systemPrompt: &APP_TEXT$BLOG_AI_SYSTEM_PROMPT_POST_ASSISTANT.
                welcomeMessage: &APP_TEXT$BLOG_MSG_AI_ASSISTANT_WELCOME.
            }
            appearance {
                displayAs: inline
                containerSelector: #blog-ai-assistant
            }
            useResponse {
                type: jsCode
                jsCode: "blog.admin.ai.post.assistant.useResponse({ text: this });"
            }
            execution {
                sequence: 10
            }
            advanced {
                initJavaScriptFunction:
                    ```javascript-browser
                    function( options ) {
                      options = $.extend( true, {}, options, {
                        "view":{ "focus": false }
                      });
                      return options;
                    }
                    ```
            }
        )

        action set-speech-recognition (
            name: Set Speech Recognition
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    blog.admin.speechRecognition.init({
                      element$: this.affectedElements
                    , objectName: "assistant"
                    , clearPreviousText: true
                    });
                    ```
            }
            affectedElements {
                selectionType: jquerySelector
                jquerySelector: .a-ChatInput-text
            }
            execution {
                sequence: 30
            }
        )

        action show-talk-to-assistant-button (
            name: Show Talk to Assistant Button
            action: show
            affectedElements {
                selectionType: button
                button: @talk-to-assistant
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction toggle-ai-assistant-speech (
        name: Toggle AI Assistant Speech
        execution {
            sequence: 110
        }
        when {
            event: click
            selectionType: button
            button: @talk-to-assistant
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: "webkitSpeechRecognition" in window
        }
        config {
            buildOption: @blog-feature-generative-ai
        }

        action remove-button (
            name: Remove Button
            action: executeJsCode
            settings {
                jsCode: this.affectedElements.remove()
            }
            affectedElements {
                selectionType: triggeringElement
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action start-stop-speech-recognition (
            name: Start / Stop Speech Recognition
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    blog.admin.speechRecognition.toggleRecording({
                      element: this.triggeringElement
                    , objectName: "assistant"
                    });
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation first-paragraph (
        name: First paragraph
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P12_FIRST_PARAGRAPH
        }
        error {
            errorMessage: Post must have at least one paragraph.
            associatedItem: @P12_BODY_HTML
        }
    )

    validation p12-valid-from-must-be-timestamp (
        name: P12_VALID_FROM must be timestamp
        execution {
            sequence: 10
        }
        validation {
            type: itemIsAValidTimestamp
            item: P12_PUBLISHED_ON
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P12_PUBLISHED_ON
        }
    )

    computation p12-body-html (
        itemName: P12_BODY_HTML
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression: replace( :P12_BODY_HTML, '#', '&#35;' )
        }
        comments {
            comments: Replace hashmark to HTML entity for preventing APEX substitutions. This must be run before we compute item P12_FIRST_PARAGRAPH.
        }
    )

    computation p12-first-paragraph (
        itemName: P12_FIRST_PARAGRAPH
        execution {
            sequence: 70
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression:
                ```plsql
                blog_admin.get_first_paragraph(
                  p_body_html => :P12_BODY_HTML
                )
                ```
        }
        comments {
            comments: Get first paragraph fro post as preview. Must be run after computation of P12_HTML_BODY.
        }
    )

    computation p12-is-active (
        itemName: P12_IS_ACTIVE
        execution {
            sequence: 60
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression:
                ```plsql
                blog_admin.request_to_post_status(
                  p_request => :REQUEST
                )
                ```
        }
        comments {
            comments: Compute IS_ACTIVE from button request.
        }
    )

    computation p12-post-desc (
        itemName: P12_POST_DESC
        execution {
            sequence: 20
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression:
                ```plsql
                blog_util.remove_whitespace(
                  p_string => :P12_POST_DESC
                )
                ```
        }
        comments {
            comments: Remove whitespace from description.
        }
    )

    computation p12-published-on (
        itemName: P12_PUBLISHED_ON
        execution {
            sequence: 50
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression: to_char( localtimestamp, :P501_INPUT_DATE_FORMAT )
        }
        serverSideCondition {
            type: itemIsNull
            item: P12_PUBLISHED_ON
        }
        comments {
            comments: Set published on if no schedule set when publishing post.
        }
    )

    process clear-published-on (
        name: Clear Published on
        type: clearSessionState
        clear {
            type: items
            items: P12_PUBLISHED_ON
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 27060510671689106
        }
        serverSideCondition {
            type: item=value
            item: P12_IS_ACTIVE
            value: 0
        }
        comments {
            comments: Clear published on item if post was draft. Then new published on will be set automatically on after submit computation e.g. in case post is published.
        }
    )

