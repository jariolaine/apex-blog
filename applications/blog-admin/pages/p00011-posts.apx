        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 48583 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BTN_EDIT_TAGS (
                sequence: 5
            )

            displayColumn CATEGORY_TITLE (
                sequence: 2
            )

            displayColumn POST_STATUS (
                sequence: 6
            )

            displayColumn POST_TITLE (
                sequence: 1
            )

            displayColumn PUBLISHED_SINCE (
                sequence: 4
            )

            displayColumn VISIBLE_TAGS (
                sequence: 3
            )

            sort (
                column: PUBLISHED_SINCE
                sort {
                    direction: desc
                    nulls: first
                    sequence: 1
                }
            )

            sort (
                column: CREATED_ON
                sort {
                    direction: desc
                    sequence: 2
                }
            )

        )

    )

    button create-post (
        buttonName: CREATE_POST
        label: New Post
        layout {
            sequence: 10
            region: @posts-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--mobileHideLabel
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                clearCache: 12
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button open-categories (
        buttonName: OPEN_CATEGORIES
        label: Categories
        layout {
            sequence: 20
            region: @posts-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-media-list
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 14
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button open-tags (
        buttonName: OPEN_TAGS
        label: All Tags
        layout {
            sequence: 30
            region: @posts-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-tags
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 15
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Reset Report
        layout {
            sequence: 40
            region: @posts-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: [
                    &APP_PAGE_ID.
                    RIR
                ]
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction change-post (
        name: Change Post
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @posts-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: triggeringElement
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction create-post (
        name: Create Post
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create-post
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @posts-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction process-all-tags (
        name: Process All Tags
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: button
            button: @open-tags
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @posts-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction process-category (
        name: Process Category
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: button
            button: @open-categories
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @posts-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

