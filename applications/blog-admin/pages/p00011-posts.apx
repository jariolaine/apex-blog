                heading: Edit Tags
                alignment: center
            }
            layout {
                sequence: 270
                columnAlignment: center
            }
            link {
                target: {
                    page: 16
                    items: {
                        P16_POST_ID: #POST_ID#
                    }
                }
                linkText: <span aria-hidden="true" class="fa fa-tags"></span>
                linkAttributes: title="&APP_TEXT$BLOG_TXT_EDIT." class="t-Button t-Button--noLabel t-Button--icon t-Button--small w40"
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: CA
            }
            enableUsersTo {
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

