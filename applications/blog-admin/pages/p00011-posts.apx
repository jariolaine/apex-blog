            columnFormatting {
                htmlExpression:
                    ```html
                    {with/}
                    TEXT:=#POST_STATUS#
                    ICON_CLASSES:=#POST_STATUS_ICON# w40
                    {apply THEME$ICON_CUSTOM/}
                    ```
            }
            source {
                dataType: STRING
