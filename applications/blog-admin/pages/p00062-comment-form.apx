    process sent-reply-notification (
        name: Sent reply notification
        type: invokeApi
        invoke {
            package: BLOG_COMMENT
            procedureOrFunction: REPLY_NOTIFY
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 38174693289729064
        }
        serverSideCondition {
            whenButtonPressed: @reply
            type: expression
            plsqlExpression:
                ```plsql
                apex_application_admin.get_build_option_status(
                   p_application_id    => :G_PUB_APP_ID
                  ,p_build_option_name => 'BLOG_FEATURE_SUBSCRIBE_COMMENTS'
                ) = 'INCLUDE'
                
                ```
        }

        parameter p_app_id (
            value {
                type: item
                item: G_PUB_APP_ID
            }
            advanced {
                displaySequence: 10
            }
        )

        parameter p_app_name (
            value {
                type: item
                item: P0_BLOG_APP_NAME
            }
            advanced {
                displaySequence: 20
            }
        )

        parameter p_email_template (
            value {
