                      p_attribute_name => 'G_OCI_LANG_AI_COMPARTMENT_OCID'
                    )
                    ```
            }
        )

        parameter (
            name: @key
            value {
                type: item
                item: P62_ID
            }
        )

        parameter (
            name: @languagecode
            value {
                type: staticValue
                staticValue: en
            }
        )

        parameter (
            name: @level
            value {
                type: staticValue
                staticValue: SENTENCE
            }
        )

        parameter (
            name: @response-body
            parameter {
                ignoreOutput: false
            }
            value {
                type: item
                item: P62_RESPOSE_BODY
            }
        )

        parameter (
            name: @singledocumentservice
