COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=./automation/docker/docker-compose.db.yml:./automation/docker/docker-compose.mcp.yml

# Optional local TEST database/ORDS images consume this password via Compose.
# It is not a SQLcl saved connection password and is not used by Make scripts
# to provision DEV/QA/PROD users. Follow the database image's password rules.
ORACLE_PWD=

# Optional development SQLcl profile source: contents of a .dbtools folder.
# Read-only source; copied into the Dev Container's persistent /home/vscode.
# If unset, the developer's existing home configuration is preserved.
APEX_BLOG_DEV_SQLCL_PROFILE_DIR=

# REQUIRED for MCP: a DIFFERENT directory containing ONLY DEV/TEST saved
# SQLcl connections (never QA/PROD). Mounted read-only into MCP and copied
# to its private runtime home at startup. Use absolute host paths for both.
APEX_BLOG_MCP_SQLCL_PROFILE_DIR=

# Optional: the normal Dev Container automatically mounts this directory
# read-only when set; without it, a tracked empty placeholder is used.
# Both standard Dev and MCP Compose configurations mount it automatically.
# The directory must exist outside Git (wallet/ and/or certificates/).
APEX_BLOG_EXTERNAL_DIR=

# Optional: the normal Dev Container uses this for build-time TLS trust when
# set; both standard Dev and MCP Compose configurations use it.
# Must reference a PEM bundle of approved CA roots, NEVER an Oracle wallet.
APEX_BLOG_BUILD_CA_BUNDLE=
