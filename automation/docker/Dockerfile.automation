# Reuse the repository's existing Make/Bash/Python automation, not a second
# deployment implementation. Oracle JDK 25 supports recent SQLcl versions.
FROM node:24-bookworm-slim AS node
FROM hashicorp/terraform:1.14.0 AS terraform
FROM python:3.12-slim-bookworm

ARG TARGETARCH
ARG RUN_UID=1000
ARG RUN_GID=1000

ENV JAVA_HOME=/opt/oracle/jdk \
    HOME=/home/agent \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    AUTOMATION_JOB_DIR=/var/lib/apex-blog/jobs
ENV PATH="${JAVA_HOME}/bin:/opt/oracle/sqlcl/bin:${PATH}"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash ca-certificates curl git libstdc++6 make procps rsync shellcheck \
      tini unzip util-linux zip && \
    rm -rf /var/lib/apt/lists/*

# node and npm are needed by pre-commit (ESLint, Stylelint, markdownlint).
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY --from=terraform /bin/terraform /usr/local/bin/terraform

# Oracle JDK 25, matching the toolchain used in development.
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) oracle_arch=x64 ;; \
      arm64) oracle_arch=aarch64 ;; \
      *) echo "Unsupported Docker architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    mkdir -p "$JAVA_HOME"; \
    curl -fsSL --retry 3 \
      "https://download.oracle.com/java/25/latest/jdk-25_linux-${oracle_arch}_bin.tar.gz" \
      -o /tmp/jdk.tar.gz; \
    tar -xzf /tmp/jdk.tar.gz -C "$JAVA_HOME" --strip-components=1; \
    rm /tmp/jdk.tar.gz

# Uses the repo's existing latest-SQLcl download. Pin the SQLcl version and
# verify its checksum separately if fully reproducible builds are required.
RUN set -eux; \
    curl -fsSL --retry 3 \
      'https://download.oracle.com/otn_software/java/sqldeveloper/sqlcl-latest.zip' \
      -o /tmp/sqlcl.zip; \
    unzip -q /tmp/sqlcl.zip -d /opt/oracle; \
    rm /tmp/sqlcl.zip; \
    chmod -R a-w /opt/oracle; \
    chmod -R a+rX /opt/oracle; \
    ln -s /opt/oracle/sqlcl/bin/sql /usr/local/bin/sql

COPY automation/mcp/requirements.txt /tmp/mcp-requirements.txt
RUN pip install --no-cache-dir -r /tmp/mcp-requirements.txt && \
    rm /tmp/mcp-requirements.txt

RUN groupadd -g "$RUN_GID" agent && \
    useradd -m -u "$RUN_UID" -g "$RUN_GID" -s /bin/bash agent && \
    mkdir -p /var/lib/apex-blog/jobs && \
    chown -R agent:agent /var/lib/apex-blog /home/agent

WORKDIR /workspace
USER agent
EXPOSE 8765
ENTRYPOINT ["tini", "--"]
CMD ["bash", "automation/mcp/start.sh"]
